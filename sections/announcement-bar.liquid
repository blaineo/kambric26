{%- liquid
  assign text = section.settings.text | strip
  assign show = false
  if section.settings.enabled and text != blank
    assign show = true
  endif
  assign cta = section.settings.cta_label | strip
  assign link = section.settings.link
-%}

{%- if show -%}
  {%- capture message -%}
    <span class="announcement-bar__text">{{ text | escape }}</span>
    {%- if cta != blank and link != blank -%}
      <span class="announcement-bar__cta">{{ cta | escape }}</span>
    {%- endif -%}
  {%- endcapture -%}

  <aside
    class="announcement-bar announcement-bar--{{ section.settings.style }} full-width"
    aria-label="{{ 'sections.announcement.label' | t }}"
  >
    {%- if link != blank -%}
      <a class="announcement-bar__link" href="{{ link }}">
    {%- else -%}
      <div class="announcement-bar__link">
    {%- endif -%}

    {%- if section.settings.style == 'marquee' -%}
      {% # Screen readers get the message once; the moving track is decorative %}
      <span class="visually-hidden">{{ text | escape }} {{ cta | escape }}</span>
      <span class="announcement-bar__viewport" aria-hidden="true">
        <span class="announcement-bar__track">
          {%- for i in (1..12) -%}
            <span class="announcement-bar__item">
              {{- message -}}
              <span class="announcement-bar__separator">✦</span>
            </span>
          {%- endfor -%}
        </span>
      </span>
    {%- else -%}
      <span class="announcement-bar__inner">{{ message }}</span>
    {%- endif -%}

    {%- if link != blank -%}
      </a>
    {%- else -%}
      </div>
    {%- endif -%}
  </aside>
{%- elsif request.design_mode -%}
  <p class="announcement-bar__editor-hint full-width">{{ 'sections.announcement.editor_hint' | t }}</p>
{%- endif -%}

{% stylesheet %}
  /* Source: Layout.tsx announcement link (bg-secondary, h-9, 10/11px, 0.3em tracking) */
  .announcement-bar {
    background: var(--color-secondary);
    color: var(--color-secondary-foreground);
  }

  .announcement-bar__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .announcement-bar__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    max-width: var(--container-header);
    height: var(--announcement-height);
    margin-inline: auto;
    padding-inline: var(--space-7);
    text-align: center;
  }

  .announcement-bar__text,
  .announcement-bar__cta {
    font-size: var(--text-10);
    letter-spacing: var(--tracking-nav);
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .announcement-bar__text {
    font-weight: var(--weight-light);
  }

  .announcement-bar__cta {
    display: none;
    font-weight: var(--weight-regular);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: color-mix(in srgb, currentcolor 50%, transparent);
    transition: text-decoration-color var(--duration-fast) var(--ease-standard);
  }

  .announcement-bar__link:hover .announcement-bar__cta {
    text-decoration-color: currentcolor;
  }

  @media (min-width: 40rem) {
    .announcement-bar__cta {
      display: inline;
    }
  }

  @media (min-width: 48rem) {
    .announcement-bar__text,
    .announcement-bar__cta {
      font-size: var(--text-11);
    }
  }

  /* Marquee: pure CSS, two identical halves → seamless loop at -50% */
  .announcement-bar__viewport {
    display: flex;
    align-items: center;
    height: var(--announcement-height);
    overflow: hidden;
  }

  .announcement-bar__track {
    display: flex;
    flex-shrink: 0;
    white-space: nowrap;
    animation: marquee var(--marquee-duration) linear infinite;
  }

  .announcement-bar--marquee .announcement-bar__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-6);
    padding-inline: var(--space-6);
  }

  .announcement-bar--marquee .announcement-bar__cta {
    display: inline;
  }

  .announcement-bar__separator {
    opacity: 0.4;
    font-size: var(--text-16);
  }

  .announcement-bar:hover .announcement-bar__track,
  .announcement-bar:focus-within .announcement-bar__track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-bar__track {
      animation: none;
    }

    .announcement-bar__viewport {
      justify-content: center;
    }

    .announcement-bar__item:not(:first-child) {
      display: none !important;
    }

    .announcement-bar__item .announcement-bar__separator {
      display: none;
    }
  }

  .announcement-bar__editor-hint {
    padding: var(--space-2);
    font-size: var(--text-12);
    text-align: center;
    color: var(--color-muted-foreground);
    background: var(--color-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.announcement.name",
  "tag": "div",
  "class": "section-announcement-bar",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "t:sections.announcement.enabled",
      "default": false
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.announcement.text",
      "default": "Summer Sale · 20% Off Select Styles"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.announcement.cta_label",
      "info": "t:sections.announcement.cta_label_info",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.announcement.link"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:sections.announcement.style",
      "options": [
        { "value": "static", "label": "t:sections.announcement.style_static" },
        { "value": "marquee", "label": "t:sections.announcement.style_marquee" }
      ],
      "default": "static",
      "info": "t:sections.announcement.style_info"
    }
  ]
}
{% endschema %}
