{% comment %}
  Shop (/collections/all) and category listing: the collection's products
  expanded into print cards (archive layout) and grouped by each print's
  collection (Shop.tsx "collection sections").

  - A print's collection: `kambric.prints[].collection`, else the product's
    first collection that isn't `frontpage` (product-prints.liquid).
  - Groups: collections that exist on the store, in the "Group order" setting
    first, then the rest alphabetically. Empty groups are never rendered.
  - "Other pieces": prints whose collection doesn't exist (e.g. the stale
    `botanicals` handle) or that have none (source "orphan cards").
  - "Show these first": pinned products lead every group they appear in
    (replaces the source's hard-coded Arielle priority).
  - Pagination (D-17): by products, so cards per page vary; grouping is per page.
  - JSON-LD: CollectionPage + ItemList of the rendered print cards.
  - `show_on` hides the whole section (no JSON-LD) on /collections/all or
    everywhere else, so collection.json can host the shop page too.
{% endcomment %}
{%- liquid
  assign show_section = false
  if collection.handle != blank
    assign show_section = true
    case section.settings.show_on
      when 'all_only'
        unless collection.handle == 'all'
          assign show_section = false
        endunless
      when 'except_all'
        if collection.handle == 'all'
          assign show_section = false
        endif
    endcase
  endif
-%}
{%- if show_section -%}
  {%- paginate collection.products by section.settings.products_per_page -%}
    {%- liquid
      assign type_filter = section.settings.product_type | strip | downcase
      assign eager_count = section.settings.eager_count
      assign pinned_list = section.settings.pinned_products
      assign card_sizes = '(min-width: 48rem) calc((100vw - 8.5rem) / 3), calc((100vw - 5.25rem) / 2)'
      assign entry_sep = '|~|'
      assign list_sep = '|#|'

      comment
        1. Products on this page that can be listed here (visibility guard,
        optional product type filter), and the pinned ones among them.
      endcomment
      assign page_ids = ','
      for product in collection.products
        if product.tags contains 'hidden' or product.handle == 'chainstitch-monogram'
          continue
        endif
        if type_filter != blank
          assign product_type = product.type | strip | downcase
          if product_type != type_filter
            continue
          endif
        endif
        assign page_ids = page_ids | append: product.id | append: ','
      endfor

      assign pinned_ids = ','
      for product in pinned_list
        assign key = ',' | append: product.id | append: ','
        if page_ids contains key
          assign pinned_ids = pinned_ids | append: product.id | append: ','
        endif
      endfor

      comment
        2. Resolve every print's collection (mirrors product-prints.liquid):
        existing collections become groups, the rest are "other pieces".
      endcomment
      assign valid_handles = ','
      assign invalid_handles = ','
      assign orphan_entries = ''
      for product in collection.products
        assign key = ',' | append: product.id | append: ','
        unless page_ids contains key
          continue
        endunless

        assign default_collection = ''
        for c in product.collections
          if c.handle != 'frontpage' and c.handle != 'all' and c.template_suffix != 'category' and c.template_suffix != 'sale'
            assign default_collection = c.handle
            break
          endif
        endfor

        assign print_option = nil
        for option in product.options_with_values
          if option.name == 'Print' or option.name == 'Colorway'
            assign print_option = option
            break
          endif
        endfor
        if print_option
          assign print_values = print_option.values
        else
          assign single_print = product.metafields.kambric.print_name.value | default: product.title
          assign print_values = single_print | split: '|||'
        endif
        assign prints_meta = product.metafields.kambric.prints.value

        for value in print_values
          assign print_value = value.name | default: value
          assign print_collection = default_collection
          if print_option
            for entry in prints_meta
              if entry.value == print_value and entry.collection != blank
                assign print_collection = entry.collection
                break
              endif
            endfor
          endif

          assign is_orphan = false
          if print_collection == blank
            assign is_orphan = true
          else
            assign handle_key = ',' | append: print_collection | append: ','
            if invalid_handles contains handle_key
              assign is_orphan = true
            elsif valid_handles contains handle_key
              assign is_orphan = false
            else
              assign candidate = collections[print_collection]
              if print_collection != 'frontpage' and print_collection != 'all' and candidate.handle == print_collection
                assign valid_handles = valid_handles | append: print_collection | append: ','
              else
                assign invalid_handles = invalid_handles | append: print_collection | append: ','
                assign is_orphan = true
              endif
            endif
          endif

          if is_orphan
            assign orphan_entries = orphan_entries | append: list_sep | append: product.id | append: entry_sep | append: print_value
          endif
        endfor
      endfor
      assign orphan_list = orphan_entries | split: list_sep

      comment
        3. Group order: the "Group order" setting, then the rest by title.
      endcomment
      assign ordered = ','
      for c in section.settings.group_order
        assign handle_key = ',' | append: c.handle | append: ','
        if valid_handles contains handle_key
          unless ordered contains handle_key
            assign ordered = ordered | append: c.handle | append: ','
          endunless
        endif
      endfor
      assign rest = ''
      assign valid_list = valid_handles | split: ','
      for group_handle in valid_list
        if group_handle == blank
          continue
        endif
        assign handle_key = ',' | append: group_handle | append: ','
        if ordered contains handle_key
          continue
        endif
        assign sort_title = collections[group_handle].title | downcase
        assign rest = rest | append: list_sep | append: sort_title | append: entry_sep | append: group_handle
      endfor
      assign rest_sorted = rest | split: list_sep | sort_natural
      for entry in rest_sorted
        if entry == blank
          continue
        endif
        assign group_handle = entry | split: entry_sep | last
        assign ordered = ordered | append: group_handle | append: ','
      endfor
      assign group_list = ordered | split: ','

      assign rendered = 0
      assign card_entries = ''
    -%}

    <div class="collection-groups full-width">
      {%- for group_handle in group_list -%}
        {%- if group_handle == blank -%}
          {%- continue -%}
        {%- endif -%}
        {%- liquid
          assign group_collection = collections[group_handle]
          assign group_count = 0
          capture group_cards
            for pass in (1..2)
              if pass == 1
                assign pass_products = pinned_list
              else
                assign pass_products = collection.products
              endif
              for product in pass_products
                assign key = ',' | append: product.id | append: ','
                unless page_ids contains key
                  continue
                endunless
                if pass == 2 and pinned_ids contains key
                  continue
                endif

                capture cards
                  render 'product-prints', product: product, collection_handle: group_handle, layout: 'archive', sizes: card_sizes, eager_count: eager_count, offset: rendered, item_class: 'collection-groups__item'
                endcapture
                assign count = cards | split: 'data-print-card' | size | minus: 1
                if count > 0
                  echo cards
                  assign rendered = rendered | plus: count
                  assign group_count = group_count | plus: count

                  capture values
                    render 'product-prints', product: product, collection_handle: group_handle, output: 'values'
                  endcapture
                  assign value_list = values | split: '|'
                  for raw_value in value_list
                    assign clean_value = raw_value | strip
                    assign card_entries = card_entries | append: list_sep | append: product.id | append: entry_sep | append: clean_value
                  endfor
                endif
              endfor
            endfor
          endcapture
        -%}
        {%- if group_count > 0 -%}
          {%- assign heading_id = 'CollectionGroup-' | append: section.id | append: '-' | append: group_handle -%}
          {%- assign group_description = group_collection.description | strip_html | strip -%}
          <section class="collection-groups__group" aria-labelledby="{{ heading_id }}">
            <div class="collection-groups__header">
              <div class="collection-groups__intro">
                <h2 class="collection-groups__heading" id="{{ heading_id }}">{{ group_collection.title | escape }}</h2>
                {%- if group_description != blank -%}
                  <p class="collection-groups__description">{{ group_description }}</p>
                {%- endif -%}
              </div>
              {%- if section.settings.show_group_count -%}
                <p class="collection-groups__count">{{ 'collections.card.pieces' | t: count: group_count }}</p>
              {%- endif -%}
            </div>
            <ul class="collection-groups__grid" role="list">
              {{- group_cards -}}
            </ul>
          </section>
        {%- endif -%}
      {%- endfor -%}

      {%- liquid
        comment
          "Other pieces": prints whose collection doesn't exist, pinned first.
        endcomment
        assign other_count = 0
        capture other_cards
          if orphan_list.size > 0
            for pass in (1..2)
              if pass == 1
                assign pass_products = pinned_list
              else
                assign pass_products = collection.products
              endif
              for product in pass_products
                assign key = ',' | append: product.id | append: ','
                unless page_ids contains key
                  continue
                endunless
                if pass == 2 and pinned_ids contains key
                  continue
                endif
                assign prefix = product.id | append: entry_sep
                assign prefix_size = prefix | size
                for entry in orphan_list
                  assign entry_prefix = entry | slice: 0, prefix_size
                  if entry_prefix != prefix
                    continue
                  endif
                  assign print_value = entry | remove_first: prefix
                  assign card_loading = 'lazy'
                  if rendered < eager_count
                    assign card_loading = 'eager'
                  endif
                  echo '<li class="collection-groups__item" data-print-card>'
                  render 'product-card', product: product, print: print_value, layout: 'archive', sizes: card_sizes, loading: card_loading
                  echo '</li>'
                  assign rendered = rendered | plus: 1
                  assign other_count = other_count | plus: 1
                  assign card_entries = card_entries | append: list_sep | append: entry
                endfor
              endfor
            endfor
          endif
        endcapture
      -%}
      {%- if other_count > 0 -%}
        {%- if section.settings.other_heading != blank -%}
          {%- assign heading_id = 'CollectionGroup-' | append: section.id | append: '-other' -%}
          <section class="collection-groups__group" aria-labelledby="{{ heading_id }}">
            <div class="collection-groups__header">
              <div class="collection-groups__intro">
                <h2 class="collection-groups__heading" id="{{ heading_id }}">{{ section.settings.other_heading | escape }}</h2>
              </div>
              {%- if section.settings.show_group_count -%}
                <p class="collection-groups__count">{{ 'collections.card.pieces' | t: count: other_count }}</p>
              {%- endif -%}
            </div>
            <ul class="collection-groups__grid" role="list">
              {{- other_cards -}}
            </ul>
          </section>
        {%- else -%}
          <div class="collection-groups__group">
            <ul class="collection-groups__grid" role="list">
              {{- other_cards -}}
            </ul>
          </div>
        {%- endif -%}
      {%- endif -%}

      {%- if rendered == 0 -%}
        <div class="collection-groups__empty">
          {%- if section.settings.empty_heading != blank -%}
            <p class="collection-groups__empty-heading">{{ section.settings.empty_heading | escape }}</p>
          {%- endif -%}
          {%- if section.settings.empty_body != blank -%}
            <div class="collection-groups__empty-body">{{ section.settings.empty_body }}</div>
          {%- endif -%}
          {%- if section.settings.empty_link_label != blank and section.settings.empty_link_url != blank -%}
            <a class="collection-groups__empty-link" href="{{ section.settings.empty_link_url }}">
              {{- section.settings.empty_link_label | escape -}}
              <span aria-hidden="true"> &rarr;</span>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="collection-groups__pagination" aria-label="{{ 'collections.pagination.label' | t }}">
          <ul class="collection-groups__pages" role="list">
            {%- if paginate.previous -%}
              <li>
                <a class="collection-groups__page collection-groups__page--step" href="{{ paginate.previous.url }}">
                  <span aria-hidden="true">&larr;</span>
                  {{ 'collections.pagination.previous' | t -}}
                </a>
              </li>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              <li>
                {%- if part.is_link -%}
                  <a class="collection-groups__page" href="{{ part.url }}">
                    <span class="visually-hidden">{{ 'collections.pagination.page' | t: number: part.title }}</span>
                    <span aria-hidden="true">{{ part.title }}</span>
                  </a>
                {%- elsif part.title == paginate.current_page -%}
                  <span class="collection-groups__page collection-groups__page--current" aria-current="page">
                    <span class="visually-hidden">{{ 'collections.pagination.page' | t: number: part.title }}</span>
                    <span aria-hidden="true">{{ part.title }}</span>
                  </span>
                {%- else -%}
                  <span class="collection-groups__page">{{ part.title }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
            {%- if paginate.next -%}
              <li>
                <a class="collection-groups__page collection-groups__page--step" href="{{ paginate.next.url }}">
                  {{- 'collections.pagination.next' | t }}
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </li>
            {%- endif -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>

    {%- if section.settings.structured_data -%}
      {%- liquid
        comment
          ItemList of the rendered cards, in page order. Merged products link
          to the print's first available variant (?variant=), single-print
          products to the product page.
        endcomment
        assign card_list = card_entries | split: list_sep
        assign items = ''
        assign position = 0
        for entry in card_list
          if entry == blank
            continue
          endif
          assign entry_parts = entry | split: entry_sep
          assign entry_id = entry_parts[0]
          assign print_value = entry_parts[1]
          for product in collection.products
            assign product_id = product.id | append: ''
            if product_id != entry_id
              continue
            endif

            assign print_index = -1
            for option in product.options_with_values
              if option.name == 'Print' or option.name == 'Colorway'
                assign print_index = option.position | minus: 1
                break
              endif
            endfor
            assign item_url = request.origin | append: product.url
            if print_index >= 0
              assign item_variant = nil
              for variant in product.variants
                if variant.options[print_index] == print_value
                  if item_variant == nil
                    assign item_variant = variant
                  endif
                  if variant.available
                    assign item_variant = variant
                    break
                  endif
                endif
              endfor
              if item_variant
                assign item_url = item_url | append: '?variant=' | append: item_variant.id
              endif
            endif

            assign item_name = product.title
            if print_value != blank and print_value != product.title
              assign item_name = item_name | append: ' — ' | append: print_value
            endif

            assign position = position | plus: 1
            assign name_json = item_name | json
            assign url_json = item_url | json
            if position > 1
              assign items = items | append: ','
            endif
            assign items = items | append: '{"@type":"ListItem","position":' | append: position | append: ',"name":' | append: name_json | append: ',"url":' | append: url_json | append: '}'
            break
          endfor
        endfor

        assign page_description = collection.description | strip_html | strip
        assign page_name = collection.title
        if collection.handle == 'all'
          assign page_name = 'collections.structured_data.all_name' | t
        endif
        assign list_name = 'collections.structured_data.item_list_name' | t: collection: page_name, shop: shop.name
      -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "CollectionPage",
          "name": {{ page_name | json }},
          {%- if page_description != blank %}
            "description": {{ page_description | json }},
          {%- endif %}
          "url": {{ canonical_url | json }}
          {%- if position > 0 -%}
            ,
            "mainEntity": {
              "@type": "ItemList",
              "name": {{ list_name | json }},
              "numberOfItems": {{ position }},
              "itemListElement": [{{ items }}]
            }
          {%- endif %}
        }
      </script>
    {%- endif -%}
  {%- endpaginate -%}
{%- endif -%}

{% stylesheet %}
  /*
    Shop.tsx: page padding px-8 / md:px-12, py-10 pb-20; groups space-y-16;
    header mb-7 pb-4 border-b border-border/40; grid 2 → 3 columns, gap-5.
  */
  .collection-groups {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    padding: var(--space-10) var(--space-8) var(--space-20);
  }

  .collection-groups__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-block-end: var(--space-7);
    padding-block-end: var(--space-4);
    border-block-end: 1px solid color-mix(in srgb, var(--color-border) 40%, transparent);
  }

  .collection-groups__intro {
    max-width: 40rem;
  }

  .collection-groups__heading {
    font-family: var(--font-serif);
    font-size: var(--text-30);
    font-weight: var(--weight-regular);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-heading);
    color: var(--color-primary);
  }

  .collection-groups__description,
  .collection-groups__count {
    font-family: var(--font-serif);
    font-size: 0.8125rem;
    font-style: italic;
  }

  .collection-groups__description {
    margin-block-start: var(--space-3);
    line-height: 1.7;
    color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
  }

  .collection-groups__count {
    display: none;
    margin-inline-start: var(--space-6);
    white-space: nowrap;
    color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
  }

  .collection-groups__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Empty state: "Nothing in this category yet." */
  .collection-groups__empty {
    padding-block: var(--space-24);
    text-align: center;
  }

  .collection-groups__empty-heading {
    font-family: var(--font-serif);
    font-size: var(--text-24);
    font-style: italic;
    color: color-mix(in srgb, var(--color-foreground) 65%, transparent);
  }

  .collection-groups__empty-body {
    margin-block-start: var(--space-4);
    font-size: var(--text-14);
    font-weight: var(--weight-light);
    color: var(--color-muted-foreground);
  }

  .collection-groups__empty-link {
    display: inline-block;
    margin-block-start: var(--space-6);
    padding-block-end: var(--space-0-5);
    font-family: var(--font-sans);
    font-size: var(--text-11);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
    color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
    border-block-end: 1px solid color-mix(in srgb, var(--color-border) 50%, transparent);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .collection-groups__empty-link:hover {
    color: var(--color-foreground);
  }

  /* Pagination */
  .collection-groups__pages {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-sans);
    font-size: var(--text-11);
    letter-spacing: var(--tracking-nav);
    text-transform: uppercase;
  }

  .collection-groups__page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding-inline: var(--space-2);
    color: var(--color-muted-foreground);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  a.collection-groups__page:hover {
    color: var(--color-foreground);
  }

  .collection-groups__page--current {
    color: var(--color-foreground);
    border-block-end: 1px solid var(--color-foreground);
  }

  @media (min-width: 48rem) {
    .collection-groups {
      padding-inline: var(--space-12);
    }

    .collection-groups__heading {
      font-size: var(--text-36);
    }

    .collection-groups__count {
      display: block;
    }

    .collection-groups__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.collection_product_groups.name",
  "class": "section-collection-product-groups",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "select",
      "id": "show_on",
      "label": "t:sections.collection_product_groups.settings.show_on.label",
      "info": "t:sections.collection_product_groups.settings.show_on.info",
      "options": [
        { "value": "always", "label": "t:sections.collection_product_groups.settings.show_on.options.always" },
        { "value": "all_only", "label": "t:sections.collection_product_groups.settings.show_on.options.all_only" },
        { "value": "except_all", "label": "t:sections.collection_product_groups.settings.show_on.options.except_all" }
      ],
      "default": "always"
    },
    {
      "type": "header",
      "content": "t:sections.collection_product_groups.settings.header_products.content"
    },
    {
      "type": "text",
      "id": "product_type",
      "label": "t:sections.collection_product_groups.settings.product_type.label",
      "info": "t:sections.collection_product_groups.settings.product_type.info"
    },
    {
      "type": "product_list",
      "id": "pinned_products",
      "label": "t:sections.collection_product_groups.settings.pinned_products.label",
      "info": "t:sections.collection_product_groups.settings.pinned_products.info",
      "limit": 12
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:sections.collection_product_groups.settings.products_per_page.label",
      "info": "t:sections.collection_product_groups.settings.products_per_page.info",
      "min": 6,
      "max": 48,
      "step": 6,
      "default": 24
    },
    {
      "type": "range",
      "id": "eager_count",
      "label": "t:sections.collection_product_groups.settings.eager_count.label",
      "info": "t:sections.collection_product_groups.settings.eager_count.info",
      "min": 0,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "t:sections.collection_product_groups.settings.header_groups.content"
    },
    {
      "type": "collection_list",
      "id": "group_order",
      "label": "t:sections.collection_product_groups.settings.group_order.label",
      "info": "t:sections.collection_product_groups.settings.group_order.info",
      "limit": 20
    },
    {
      "type": "checkbox",
      "id": "show_group_count",
      "label": "t:sections.collection_product_groups.settings.show_group_count.label",
      "default": true
    },
    {
      "type": "text",
      "id": "other_heading",
      "label": "t:sections.collection_product_groups.settings.other_heading.label",
      "info": "t:sections.collection_product_groups.settings.other_heading.info"
    },
    {
      "type": "header",
      "content": "t:sections.collection_product_groups.settings.header_empty.content"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "t:sections.collection_product_groups.settings.empty_heading.label",
      "default": "Nothing in this category yet."
    },
    {
      "type": "richtext",
      "id": "empty_body",
      "label": "t:sections.collection_product_groups.settings.empty_body.label"
    },
    {
      "type": "text",
      "id": "empty_link_label",
      "label": "t:sections.collection_product_groups.settings.empty_link_label.label"
    },
    {
