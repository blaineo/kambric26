{% comment %}
  Events page dark hero (source: Events.tsx "HERO"). Full-bleed photo, a
  two-line heading (plain + italic accent line), and an italic subtitle.
  This is the page's only <h1> and its LCP image (`loading: 'priority'`).

  The source shows no visible breadcrumb trail on /events, so breadcrumbs
  render JSON-LD-only (`visible: false`) — still giving search engines a
  Home › Events trail.
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign has_image = false
  if s.image != blank
    assign has_image = true
  endif
-%}

<section class="events-hero full-width" data-has-image="{{ has_image }}">
  {%- render 'breadcrumbs', visible: false -%}

  <div class="events-hero__media">
    {%- if has_image -%}
      {%- render 'picture',
        image: s.image,
        sizes: '100vw',
        loading: 'priority',
        alt: s.image_alt,
        class: 'events-hero__picture picture--cover'
      -%}
      <div class="events-hero__overlay" aria-hidden="true"></div>
    {%- elsif request.design_mode -%}
      {%- render 'picture', image: blank, sizes: '100vw' -%}
    {%- endif -%}
  </div>

  <div class="events-hero__inner">
    {%- if s.eyebrow != blank -%}
      {%- render 'eyebrow', text: s.eyebrow, on_dark: true, class: 'events-hero__eyebrow' -%}
    {%- endif -%}

    {%- render 'section-heading',
      heading: s.heading,
      heading_em: s.heading_em,
      tag: 'h1',
      size: 'hero',
      on_dark: true,
      class: 'events-hero__title'
    -%}

    {%- if s.subtitle != blank -%}
      <p class="events-hero__subtitle">{{ s.subtitle | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  /* Source: Events.tsx h1, clamp(3.5rem, 10vw, 7.5rem), leading 0.92; italic line hsl(34 44% 62%) */
  .events-hero .section-heading {
    font-size: clamp(3.5rem, 10vw, 7.5rem);
    line-height: 0.92;
  }

  .events-hero .section-heading em {
    color: var(--color-hero-accent);
  }

  /* Source: Events.tsx hero, py-24 px-6, bg hsl(24 18% 13%) (= hero background) */
  .events-hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-24);
    background: var(--color-hero-background);
    color: var(--color-hero-foreground);
  }

  .events-hero__media {
    position: absolute;
    inset: 0;
  }

  .events-hero__media > .events-hero__picture {
    position: absolute;
    inset: 0;
  }

  /* Source: linear-gradient(to right, hsla(...,0.55), hsla(...,0.28)) */
  .events-hero__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--color-hero-background) 60%, transparent) 0%,
      color-mix(in srgb, var(--color-hero-background) 30%, transparent) 100%
    );
  }

  .events-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 56rem;
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .events-hero__eyebrow {
    margin-block-end: var(--space-10);
    opacity: 0.85;
  }

  .events-hero__title {
    margin-block-end: var(--space-10);
    color: var(--color-hero-foreground);
  }

  .events-hero__subtitle {
    max-width: 34rem;
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-18);
    line-height: var(--leading-relaxed);
    color: color-mix(in srgb, var(--color-hero-foreground) 78%, transparent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.events_hero.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.about_hero.settings.header_image.content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:labels.alt_text",
      "info": "t:labels.alt_text_info"
    },
    {
      "type": "header",
      "content": "t:sections.about_hero.settings.header_text.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.text",
      "default": "Events & Pop-Ups"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Where to find us"
    },
    {
      "type": "text",
      "id": "heading_em",
      "label": "t:labels.heading_em",
      "info": "t:labels.heading_em_info",
      "default": "in person."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "t:sections.about_hero.settings.subtitle.label",
      "default": "Kambric pieces are best met in person — at a small trunk show, a seasonal pop-up, or an open studio afternoon. A short list of what's coming next and where we've been."
    }
  ],
  "presets": [
    { "name": "t:sections.events_hero.name" }
  ]
}
{% endschema %}
