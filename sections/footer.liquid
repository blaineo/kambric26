{%- comment -%}
  Source: Layout.tsx footer. Centred wordmark, then up to four columns
  (brand text + social | menu | menu | newsletter), then the legal line.
{%- endcomment -%}

<footer class="site-footer full-width">
  <div class="site-footer__logo-row">
    <a class="site-footer__logo" href="{{ routes.root_url }}">
      {%- render 'logo', height: 36 -%}
    </a>
  </div>

  <div class="site-footer__columns">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'brand' -%}
          <div class="site-footer__column" {{ block.shopify_attributes }}>
            {%- if block.settings.text != blank -%}
              <div class="site-footer__blurb">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.show_social -%}
              <ul class="site-footer__social" role="list">
                {%- if settings.social_instagram != blank -%}
                  <li>
                    <a class="site-footer__social-link" href="{{ settings.social_instagram }}" target="_blank" rel="noopener me">
                      {%- render 'icon', name: 'instagram' -%}
                      <span class="visually-hidden">{{ 'footer.social_instagram' | t: shop: shop.name }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_pinterest != blank -%}
                  <li>
                    <a class="site-footer__social-link" href="{{ settings.social_pinterest }}" target="_blank" rel="noopener me">
                      {%- render 'icon', name: 'pinterest' -%}
                      <span class="visually-hidden">{{ 'footer.social_pinterest' | t: shop: shop.name }}</span>
                    </a>
                  </li>
                {%- endif -%}
              </ul>
            {%- endif -%}
          </div>

        {%- when 'menu' -%}
          {%- assign menu = block.settings.menu -%}
          {%- if menu != blank and menu.links.size > 0 -%}
            {%- assign heading = block.settings.heading | default: menu.title -%}
            <nav class="site-footer__column" aria-labelledby="FooterMenu-{{ block.id }}" {{ block.shopify_attributes }}>
              <h2 id="FooterMenu-{{ block.id }}" class="site-footer__heading">{{ heading | escape }}</h2>
              <ul class="site-footer__links" role="list">
                {%- for link in menu.links -%}
                  <li>
                    <a
                      class="site-footer__link"
                      href="{{ link.url }}"
                      {% if link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{- link.title | escape -}}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </nav>
          {%- elsif request.design_mode -%}
            <p class="site-footer__column site-footer__editor-hint" {{ block.shopify_attributes }}>
              {{ 'sections.footer.editor_hint_menu' | t }}
            </p>
          {%- endif -%}

        {%- when 'newsletter' -%}
          <div class="site-footer__column" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="site-footer__heading" id="FooterNewsletter-{{ block.id }}">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- form 'customer', id: 'FooterNewsletterForm', class: 'site-footer__newsletter' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              {%- if form.posted_successfully? -%}
                <p class="site-footer__form-message" role="status">
                  {{ 'footer.newsletter_success' | t }}
                </p>
              {%- else -%}
                <label class="visually-hidden" for="FooterNewsletterEmail">{{ 'footer.newsletter_label' | t }}</label>
                <input
                  id="FooterNewsletterEmail"
                  class="site-footer__input"
                  type="email"
                  name="contact[email]"
                  autocomplete="email"
                  required
                  placeholder="{{ 'footer.newsletter_placeholder' | t }}"
                  {% if form.errors %}
                    aria-invalid="true" aria-describedby="FooterNewsletterError"
                  {% endif %}
                >
                {%- if form.errors -%}
                  <p id="FooterNewsletterError" class="site-footer__form-message site-footer__form-message--error">
                    {{ form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email }}
                  </p>
                {%- endif -%}
                <button class="site-footer__submit" type="submit">{{ 'footer.newsletter_submit' | t }}</button>
              {%- endif -%}
            {%- endform -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="site-footer__legal">
    <p>
      &copy; {{ 'now' | date: '%Y' }}
      {{ shop.name | escape -}}
      {%- if section.settings.location != blank %}
        <span aria-hidden="true">&nbsp;·&nbsp;</span>{{ section.settings.location | escape }}
      {%- endif -%}
      {%- if shop.privacy_policy %}
        <span aria-hidden="true">&nbsp;·&nbsp;</span><a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title | escape }}</a>
      {%- endif -%}
      {%- if shop.terms_of_service %}
        <span aria-hidden="true">&nbsp;·&nbsp;</span><a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title | escape }}</a>
      {%- endif -%}
    </p>
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    border-top: 1px solid color-mix(in srgb, var(--color-border) 50%, transparent);
  }

  .site-footer__logo-row {
    display: flex;
    justify-content: center;
    padding: var(--space-16) var(--space-7) var(--space-10);
  }

  .site-footer__logo {
    display: inline-flex;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  .site-footer__logo:hover {
    opacity: 0.8;
  }

  .site-footer__logo img {
    width: auto;
    height: 2.25rem;
  }

  .site-footer__columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem var(--space-10);
    max-width: var(--container-7xl);
    margin-inline: auto;
    padding: 0 var(--space-7) var(--space-20);
  }

  @media (min-width: 48rem) {
    .site-footer__columns {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .site-footer__columns {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .site-footer__blurb {
    max-width: 20rem;
    font-size: var(--text-12);
    line-height: var(--leading-loose);
    color: var(--color-muted-foreground);
  }

  .site-footer__social {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    color: color-mix(in srgb, var(--color-foreground) 60%, transparent);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .site-footer__social-link:hover {
    color: var(--color-foreground);
  }

  .site-footer__heading {
    margin-bottom: var(--space-6);
    font-family: var(--font-sans);
    font-size: var(--text-10);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-label);
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }

  .site-footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__link {
    font-size: var(--text-14);
    text-decoration: none;
    color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
    transition: color var(--duration-medium) var(--ease-standard);
  }

  .site-footer__link:hover {
    color: var(--color-primary);
  }

  .site-footer__newsletter {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .site-footer__input {
    width: 100%;
    padding: 0 0 var(--space-2);
    background: transparent;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-foreground) 40%, transparent);
    font-size: var(--text-14);
    transition: border-color var(--duration-fast) var(--ease-standard);
  }

  .site-footer__input::placeholder {
    color: var(--color-muted-foreground);
    opacity: 1;
  }

  .site-footer__input:focus {
    outline: none;
    border-bottom-color: var(--color-primary);
  }

  .site-footer__input:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 4px;
  }

  .site-footer__submit {
    align-self: flex-start;
    font-size: var(--text-12);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: var(--weight-regular);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .site-footer__submit:hover {
    color: var(--color-primary);
  }

  .site-footer__form-message {
    font-size: var(--text-14);
    font-style: italic;
    color: var(--color-primary);
  }

  .site-footer__form-message--error {
    font-style: normal;
    color: var(--color-destructive);
  }

  .site-footer__editor-hint {
    font-size: var(--text-12);
    color: var(--color-muted-foreground);
  }

  .site-footer__legal {
    padding: 1.75rem var(--space-7);
    border-top: 1px solid color-mix(in srgb, var(--color-border) 40%, transparent);
    text-align: center;
    font-size: var(--text-10);
    letter-spacing: var(--tracking-footer);
    color: var(--color-muted-foreground);
  }

  .site-footer__legal a {
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .site-footer__legal a:hover {
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "tag": "div",
  "class": "section-footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "location",
      "label": "t:sections.footer.location",
      "default": "Northern California"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "t:sections.footer.blocks.brand.name",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.footer.blocks.brand.text",
          "default": "<p>Small-batch contemporary womenswear rooted in hand-painted heritage prints from the 1960's and 70s.</p>"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "t:sections.footer.blocks.brand.show_social",
          "info": "t:sections.footer.blocks.brand.show_social_info",
          "default": true
        }
      ]
    },
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.menu.heading",
          "info": "t:sections.footer.blocks.menu.heading_info"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:labels.menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:sections.footer.blocks.newsletter.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.newsletter.heading",
          "default": "Stay close"
        },
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.newsletter.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.footer"
    }
  ]
}
{% endschema %}
