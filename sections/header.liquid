{%- liquid
  # Garments only: monogram fee lines (_fee = '1') aren't counted, so the header
  # matches the cart page's item count (owner decision 2026-09-28).
  assign garment_count = 0
  for item in cart.items
    unless item.properties['_fee'] == '1'
      assign garment_count = garment_count | plus: item.quantity
    endunless
  endfor

  assign menu = section.settings.menu
  assign has_menu = false
  if menu != blank and menu.links.size > 0
    assign has_menu = true
  endif
-%}

<header class="site-header full-width">
  <div class="site-header__inner">
    {%- if has_menu -%}
      <kg-mobile-menu class="site-header__toggle">
        <button
          type="button"
          class="site-header__toggle-button"
          aria-haspopup="dialog"
          aria-controls="MobileMenu"
          aria-expanded="false"
          data-mobile-menu-open
        >
          {{ 'header.menu' | t }}
        </button>

        <dialog id="MobileMenu" class="mobile-menu" aria-label="{{ 'header.menu' | t }}" scroll-lock>
          <div class="mobile-menu__bar">
            <button type="button" class="site-header__toggle-button" data-mobile-menu-close>
              {{ 'header.close' | t }}
            </button>
          </div>
          <nav aria-label="{{ 'header.nav_label' | t }}">
            <ul class="mobile-menu__list" role="list">
              {%- liquid
                assign i = 0
                assign divide_next = false
              -%}
              {%- for link in menu.links -%}
                {%- liquid
                  assign collection_links = link.links | where: 'type', 'collection_link'
                  assign expand = false
                  if link.links.size > 0 and collection_links.size < link.links.size
                    assign expand = true
                  endif
                -%}
                {%- if expand -%}
                  {%- comment -%}
                    Source parity: a submenu of plain links (e.g. Shop → Dresses…Sale)
                    is listed inline, followed by a divider.
                  {%- endcomment -%}
                  {%- for child in link.links -%}
                    <li class="mobile-menu__item{% if divide_next %} mobile-menu__item--divided{% endif %}" style="--i: {{ i }}">
                      <a class="mobile-menu__link" href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>
                        {{- child.title | escape -}}
                      </a>
                    </li>
                    {%- liquid
                      assign i = i | plus: 1
                      assign divide_next = false
                    -%}
                  {%- endfor -%}
                  {%- assign divide_next = true -%}
                {%- else -%}
                  <li class="mobile-menu__item{% if divide_next %} mobile-menu__item--divided{% endif %}" style="--i: {{ i }}">
                    <a class="mobile-menu__link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
                      {{- link.title | escape -}}
                    </a>
                  </li>
                  {%- liquid
                    assign i = i | plus: 1
                    assign divide_next = false
                  -%}
                {%- endif -%}
              {%- endfor -%}
              <li class="mobile-menu__item" style="--i: {{ i }}">
                <a class="mobile-menu__link" href="{{ routes.cart_url }}">
                  {{- 'header.cart' | t -}}
                  {%- if garment_count > 0 %} ({{ garment_count }}){% endif -%}
                </a>
              </li>
            </ul>
          </nav>
        </dialog>
      </kg-mobile-menu>
    {%- endif -%}

    <a class="site-header__logo" href="{{ routes.root_url }}">
      {%- render 'logo', height: settings.logo_height, loading: 'eager' -%}
    </a>

    {%- if has_menu -%}
      <kg-header-menu class="site-header__nav">
        <nav aria-label="{{ 'header.nav_label' | t }}">
          <ul class="site-nav" role="list">
            {%- for link in menu.links -%}
              {%- liquid
                assign has_dropdown = false
                if link.links.size > 0
                  assign has_dropdown = true
                endif
                assign collection_links = link.links | where: 'type', 'collection_link'
                assign serif_dropdown = false
                if has_dropdown and collection_links.size == link.links.size
                  assign serif_dropdown = true
                endif
              -%}
              <li class="site-nav__item{% if has_dropdown %} site-nav__item--dropdown{% endif %}">
                <a
                  class="site-nav__link{% if link.active or link.child_active %} site-nav__link--active{% endif %}"
                  href="{{ link.url }}"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </a>
                {%- if has_dropdown -%}
                  <button
                    type="button"
                    class="site-nav__toggle"
                    aria-expanded="false"
                    aria-controls="SiteNavDropdown-{{ forloop.index }}"
                  >
                    <span class="visually-hidden">{{ 'header.toggle_submenu' | t: title: link.title }}</span>
                    {%- render 'icon', name: 'chevron-down' -%}
                  </button>
                  <ul
                    id="SiteNavDropdown-{{ forloop.index }}"
                    class="site-nav__dropdown{% if serif_dropdown %} site-nav__dropdown--serif{% endif %}"
                    role="list"
                  >
                    {%- for child in link.links -%}
                      <li>
                        <a
                          class="site-nav__dropdown-link"
                          href="{{ child.url }}"
                          {% if child.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{- child.title | escape -}}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      </kg-header-menu>
    {%- elsif request.design_mode -%}
      <p class="site-header__editor-hint">{{ 'sections.header.editor_hint_menu' | t }}</p>
    {%- endif -%}

    <div class="site-header__icons">
      <a class="site-header__icon" href="{{ routes.search_url }}">
        {%- render 'icon', name: 'search' -%}
        <span class="visually-hidden">{{ 'header.search' | t }}</span>
      </a>
      <a class="site-header__icon" href="{{ routes.cart_url }}">
        {%- render 'icon', name: 'bag' -%}
        <span class="visually-hidden">
          {{- 'header.cart' | t -}}
          {%- if garment_count > 0 %} ({{ 'header.cart_count' | t: count: garment_count }}){% endif -%}
        </span>
        {%- if garment_count > 0 -%}
          <span class="site-header__count" aria-hidden="true">{{ garment_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </div>
</header>

{%- if has_menu -%}
  <script src="{{ 'component-header.js' | asset_url }}" type="module" defer="defer"></script>
{%- endif -%}

{% stylesheet %}
  /* Source: Layout.tsx header (sticky, 58px, bg-background/96 + blur, 1400px, px-7) */
  .section-header {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .site-header {
    background: color-mix(in srgb, var(--color-background) 96%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid color-mix(in srgb, var(--color-border) 50%, transparent);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-areas: 'toggle logo icons';
    align-items: center;
    max-width: var(--container-header);
    height: var(--header-height);
    margin-inline: auto;
    padding-inline: var(--space-7);
  }

  .site-header__toggle {
    grid-area: toggle;
    justify-self: start;
  }

  .site-header__toggle-button {
    font-size: var(--text-10);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-footer);
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
    min-height: 2.25rem;
  }

  .site-header__logo {
    grid-area: logo;
    display: inline-flex;
    align-items: center;
    justify-self: center;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  .site-header__logo:hover {
    opacity: 0.8;
  }

  .site-header__logo img {
    width: auto;
    height: var(--logo-height-mobile);
  }

  .site-header__nav,
  .site-header__editor-hint {
    display: none;
  }

  .site-header__icons {
    grid-area: icons;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .site-header__icon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    color: color-mix(in srgb, var(--color-foreground) 60%, transparent);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .site-header__icon:hover {
    color: var(--color-foreground);
  }

  .site-header__count {
    position: absolute;
    top: -2px;
    right: -2px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 16px;
    height: 16px;
    padding-inline: var(--space-1);
    border-radius: 999px;
    background: var(--color-foreground);
    color: var(--color-background);
    font-size: var(--text-11);
    line-height: 1;
  }

  @media (min-width: 48rem) {
    .site-header__inner {
      grid-template-areas: 'logo nav icons';
    }

    .site-header__toggle {
      display: none;
    }

    .site-header__logo {
      justify-self: start;
    }

    .site-header__logo img {
      height: var(--logo-height);
    }

    .site-header__nav {
      grid-area: nav;
      display: block;
    }

    .site-header__editor-hint {
      grid-area: nav;
      display: block;
      font-size: var(--text-12);
      color: var(--color-muted-foreground);
    }
  }

  /* Desktop nav */
  .site-nav {
    display: flex;
    align-items: center;
    margin: 0;
  }

  .site-nav__item {
    position: relative;
    display: flex;
    align-items: center;
  }

  .site-nav__item + .site-nav__item::before {
    content: '';
    width: 1px;
    height: 1rem;
    margin-inline: var(--space-1-5);
    background: var(--color-border);
  }

  .site-nav__link {
    display: flex;
    align-items: center;
    height: var(--header-height);
    padding-inline: 14px;
    font-size: var(--text-11);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-nav);
    text-transform: uppercase;
    text-decoration: none;
    color: color-mix(in srgb, var(--color-foreground) 75%, transparent);
    transition: color 200ms var(--ease-standard);
  }

  .site-nav__item--dropdown .site-nav__link {
    padding-inline-end: 0;
  }

  .site-nav__link:hover,
  .site-nav__link--active,
  .site-nav__item[data-open] .site-nav__link {
    color: var(--color-foreground);
  }

  .site-nav__toggle {
    display: flex;
    align-items: center;
    height: var(--header-height);
    padding-inline: var(--space-1-5) 14px;
    color: color-mix(in srgb, var(--color-foreground) 75%, transparent);
  }

  .site-nav__toggle .icon {
    transition: transform 200ms var(--ease-standard);
  }

  .site-nav__item:hover .site-nav__toggle .icon,
  .site-nav__item[data-open] .site-nav__toggle .icon {
    transform: rotate(180deg);
  }

  .site-nav__dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    z-index: 50;
    min-width: 200px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -4px);
    transition:
      opacity var(--duration-quick) var(--ease-standard),
      transform var(--duration-quick) var(--ease-standard),
      visibility 0s linear var(--duration-quick);
  }

  .site-nav__item:hover > .site-nav__dropdown,
  .site-nav__item[data-open] > .site-nav__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    transition-delay: 0s;
  }

  .site-nav__item[data-closed] > .site-nav__dropdown {
    opacity: 0;
    visibility: hidden;
  }

  .site-nav__dropdown li + li {
    border-top: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent);
  }

  .site-nav__dropdown-link {
    display: flex;
    align-items: center;
    padding: var(--space-3) var(--space-5);
    font-size: var(--text-10);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-dropdown);
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
    transition:
      background-color var(--duration-quick) var(--ease-standard),
      color var(--duration-quick) var(--ease-standard);
  }

  .site-nav__dropdown-link:hover,
  .site-nav__dropdown-link:focus-visible {
    background: color-mix(in srgb, var(--color-foreground) 5%, var(--color-background));
    color: var(--color-foreground);
  }

  /* Collection submenus: serif italic (source: Collections dropdown) */
  .site-nav__dropdown--serif {
    min-width: 220px;
  }

  .site-nav__dropdown--serif .site-nav__dropdown-link {
    padding-block: var(--space-3-5);
    font-family: var(--font-serif);
    font-size: var(--text-22);
    font-style: italic;
    font-weight: var(--weight-regular);
    letter-spacing: normal;
    line-height: 1;
    text-transform: none;
    color: var(--color-foreground);
  }

  /* Mobile menu (native <dialog>: focus trap, Escape, inert page) */
  .mobile-menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .mobile-menu::backdrop {
    background: transparent;
  }

  .mobile-menu__bar {
    display: flex;
    align-items: center;
    height: var(--header-height);
    padding-inline: var(--space-7);
  }

  .mobile-menu__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    margin: 0;
    padding: calc(var(--space-24) - var(--header-height)) var(--space-8) var(--space-12);
  }

  .mobile-menu__item--divided {
    padding-top: var(--space-6);
    border-top: 1px solid color-mix(in srgb, var(--color-border) 40%, transparent);
  }

  .mobile-menu__link {
    display: block;
    font-family: var(--font-serif);
    font-size: var(--text-30);
    font-weight: var(--weight-light);
    letter-spacing: -0.025em;
    line-height: 1.1;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .mobile-menu__link:hover {
    color: var(--color-primary);
  }

  @keyframes mobile-menu-item-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  .mobile-menu[open] .mobile-menu__item {
    animation: mobile-menu-item-in var(--duration-base) var(--ease-out-expo) both;
    animation-delay: calc(var(--i, 0) * 60ms);
  }

  @media (min-width: 48rem) {
    .mobile-menu {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "tag": "div",
  "class": "section-header",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu",
      "info": "t:sections.header.menu_info"
    }
  ]
}
{% endschema %}
