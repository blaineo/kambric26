{% comment %}
  Home editorial story + archive collage (source: Home.tsx EDITORIAL STORY).
  Text column (eyebrow, serif heading + italic line, body, CTA) at 3/5 and a
  3:4 collage at 2/5 from 48rem (the source's md:grid-cols-5). The collage is
  a 5-column × 6-row grid: the first photo spans 3 × 6, the next two 2 × 3.
  Photos are "Photo" blocks (max 3) with alt text and a crop position.
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign image_count = 0
  for block in section.blocks
    if block.settings.image != blank
      assign image_count = image_count | plus: 1
    endif
  endfor
  assign show_collage = false
  if image_count > 0 or request.design_mode and section.blocks.size > 0
    assign show_collage = true
  endif
-%}

<section class="home-story full-width{% unless show_collage %} home-story--text-only{% endunless %}">
  <div class="home-story__inner">
    <div class="home-story__text">
      {%- if s.eyebrow != blank -%}
        {%- render 'eyebrow', text: s.eyebrow, class: 'home-story__eyebrow' -%}
      {%- endif -%}
      {%- if s.heading != blank or s.heading_em != blank -%}
        {%- render 'section-heading',
          heading: s.heading,
          heading_em: s.heading_em,
          tag: 'h2',
          size: 'xl',
          class: 'home-story__heading'
        -%}
      {%- endif -%}
      {%- if s.body != blank -%}
        <div class="home-story__body">{{ s.body }}</div>
      {%- endif -%}
      {%- if s.cta_label != blank and s.cta_link != blank -%}
        {%- render 'button', label: s.cta_label, url: s.cta_link, variant: 'outline', class: 'home-story__cta' -%}
      {%- endif -%}
    </div>

    {%- if show_collage -%}
      <div class="home-story__collage">
        {%- for block in section.blocks -%}
          {%- liquid
            if forloop.first
              assign img_sizes = '(min-width: 72rem) 250px, (min-width: 48rem) 22vw, 60vw'
            else
              assign img_sizes = '(min-width: 72rem) 165px, (min-width: 48rem) 15vw, 40vw'
            endif
            assign position = block.settings.position | default: 'center' | escape
            assign photo_alt = block.settings.alt | default: block.settings.image.alt | default: ''
          -%}
          <div class="home-story__photo" style="--photo-position: {{ position }};" {{ block.shopify_attributes }}>
            {%- render 'picture',
              image: block.settings.image,
              alt: photo_alt,
              sizes: img_sizes,
              widths: '240, 360, 480, 600, 720',
              class: 'home-story__picture picture--cover'
            -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  /*
    Source: py-20 px-6 my-8, bg hsl(36 22% 89%); max-w-6xl grid md:grid-cols-5
    gap-12 items-center; text md:col-span-3; collage md:col-span-2 aspect-[3/4]
    grid-cols-5 grid-rows-6 gap-2.5, shadow-sm, hover zoom 1.04 over 1400ms.
    Body: 16px, leading-loose, foreground/65, max-w-lg, light; mb-6 / last mb-10.
  */
  .home-story {
    margin-block: var(--space-8);
    padding-block: var(--space-20);
    background: color-mix(in srgb, var(--color-muted) 45%, var(--color-background));
  }

  .home-story__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-12);
    align-items: center;
    max-width: var(--container-6xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .eyebrow.home-story__eyebrow {
    margin-block-end: var(--space-6);
    font-weight: var(--weight-regular);
  }

  .section-heading.home-story__heading {
    margin-block-end: var(--space-8);
    letter-spacing: -0.025em;
  }

  .home-story__body {
    max-width: 32rem;
    margin-block-end: var(--space-10);
    font-size: var(--text-16);
    font-weight: var(--weight-light);
    line-height: var(--leading-loose);
    color: color-mix(in srgb, var(--color-foreground) 65%, transparent);
  }

  .home-story__body > * + * {
    margin-block-start: var(--space-6);
  }

  .home-story__body a {
    color: var(--color-foreground);
  }

  .home-story__collage {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    grid-template-rows: repeat(6, minmax(0, 1fr));
    gap: var(--space-2-5);
    aspect-ratio: 3 / 4;
  }

  .home-story__photo {
    position: relative;
    grid-column: span 2;
    grid-row: span 3;
    overflow: hidden;
    box-shadow: 0 1px 2px 0 var(--elevate-1);
  }

  .home-story__photo:first-child {
    grid-column: span 3;
    grid-row: span 6;
  }

  .home-story__photo:only-child {
    grid-column: 1 / -1;
  }

  .home-story__photo:nth-child(2):last-child {
    grid-row: span 6;
  }

  .home-story__photo > .home-story__picture,
  .home-story__photo > .picture__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .home-story__picture > img {
    object-position: var(--photo-position);
    transition: transform var(--duration-slow) var(--ease-standard);
  }

  .home-story__photo:hover .home-story__picture > img {
    transform: scale(1.04);
  }

  @media (min-width: 48rem) {
    .home-story__inner {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .home-story__text {
      grid-column: span 3;
    }

    .home-story__collage {
      grid-column: span 2;
    }

    .home-story--text-only .home-story__text {
      grid-column: 1 / -1;
    }
  }

  /* Source: text slides in from x -20, collage from x 20 (+0.15s), once in view */
  @keyframes home-story-in-left {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
  }

  @keyframes home-story-in-right {
    from {
      opacity: 0;
      transform: translateX(20px);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .home-story__text {
        animation: home-story-in-left linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 30%;
      }

      .home-story__collage {
        animation: home-story-in-right linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 35%;
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.home_story.name",
  "tag": "div",
  "class": "section-home-story",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.home_story.settings.eyebrow.label",
      "default": "The Story Behind the Prints"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Her legacy,"
    },
    {
      "type": "text",
      "id": "heading_em",
      "label": "t:labels.heading_em",
      "info": "t:labels.heading_em_info",
      "default": "carried on."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:sections.home_story.settings.body.label",
      "info": "t:sections.home_story.settings.body.info"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.button_label",
      "default": "Read the Archive Story"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:labels.link"
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "t:sections.home_story.blocks.photo.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image",
          "info": "t:sections.home_story.blocks.photo.settings.image.info"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "t:labels.alt_text",
          "info": "t:labels.alt_text_info"
        },
        {
          "type": "text",
          "id": "position",
          "label": "t:sections.home_story.blocks.photo.settings.position.label",
          "info": "t:sections.home_story.blocks.photo.settings.position.info",
          "default": "center"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.home_story.name",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
