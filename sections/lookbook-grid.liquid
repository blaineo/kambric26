{% comment %}
  Home lookbook (source: Home.tsx LOOKBOOK). Divider eyebrow, heading with an
  inline italic word, a short intro (desktop only), then an editorial grid of
  "Look" blocks. From 48rem the grid has 12 columns: look 1 is the large
  7-column 4:5 feature, looks 2–3 stack beside it (5 columns, sharing its
  height), and every further look is a 4-column 3:4 portrait (three per row).
  Below 48rem looks stack full width (4:5, 4:3, 4:3, then 3:4).
  Each look: photo, alt text, crop position, number label, caption and an
  optional product link (the whole photo is the link).
{% endcomment %}
{%- liquid
  assign s = section.settings
  comment
    Looks without a photo only show in the theme editor (as placeholders);
    with no photos at all the section is hidden on the live page.
  endcomment
  assign look_count = 0
  for block in section.blocks
    if block.settings.image != blank or request.design_mode
      assign look_count = look_count | plus: 1
    endif
  endfor
-%}
{%- if look_count > 0 -%}

<section
  class="lookbook full-width"
  {% if s.heading != blank %}
    aria-labelledby="LookbookHeading-{{ section.id }}"
  {% endif %}
>
  <div class="lookbook__inner">
    {%- if s.eyebrow != blank -%}
      <div class="lookbook__divider">
        <span class="lookbook__rule" aria-hidden="true"></span>
        {%- render 'eyebrow', text: s.eyebrow, class: 'lookbook__eyebrow' -%}
        <span class="lookbook__rule" aria-hidden="true"></span>
      </div>
    {%- endif -%}

    {%- if s.heading != blank or s.heading_em != blank or s.intro != blank -%}
      <div class="lookbook__header">
        {%- if s.heading != blank or s.heading_em != blank -%}
          <h2 class="lookbook__heading" id="LookbookHeading-{{ section.id }}">
            {{- s.heading | escape -}}
            {%- if s.heading_em != blank %} <em>{{ s.heading_em | escape }}</em>{%- endif -%}
          </h2>
        {%- endif -%}
        {%- if s.intro != blank -%}
          <p class="lookbook__intro">{{ s.intro | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="lookbook__grid" role="list">
        {%- assign look_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.image == blank and request.design_mode == false -%}
            {%- continue -%}
          {%- endif -%}
          {%- liquid
            assign look_index = look_index | plus: 1
            assign b = block.settings
            case look_index
              when 1
                assign img_sizes = '(min-width: 80rem) 720px, (min-width: 48rem) 58vw, calc(100vw - 3rem)'
              when 2, 3
                assign img_sizes = '(min-width: 80rem) 510px, (min-width: 48rem) 41vw, calc(100vw - 3rem)'
              else
                assign img_sizes = '(min-width: 80rem) 410px, (min-width: 48rem) 33vw, calc(100vw - 3rem)'
            endcase
            assign position = b.position | default: 'center' | escape
            assign look_alt = b.alt | default: b.image.alt | default: ''
            assign link_label = b.link_label | default: b.caption
          -%}
          <li class="lookbook__item" style="--look-position: {{ position }};" {{ block.shopify_attributes }}>
            <figure class="lookbook__figure">
              {%- render 'picture',
                image: b.image,
                alt: look_alt,
                sizes: img_sizes,
                widths: '360, 540, 720, 900, 1080, 1440',
                class: 'lookbook__picture picture--cover'
              -%}
              <div class="lookbook__shade" aria-hidden="true"></div>
              {%- if b.number != blank or b.caption != blank -%}
                <figcaption class="lookbook__caption">
                  {%- if b.number != blank -%}
                    <span class="lookbook__number">{{ b.number | escape }}</span>
                  {%- endif -%}
                  {%- if b.caption != blank -%}
                    <span class="lookbook__label">{{ b.caption | escape }}</span>
                  {%- endif -%}
                </figcaption>
              {%- endif -%}
            </figure>
            {%- if b.link != blank -%}
              <a class="lookbook__link" href="{{ b.link }}">
                <span class="visually-hidden">{{ link_label | default: b.number | escape }}</span>
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% stylesheet %}
  /*
    Source: py-20 px-6 max-w-7xl; header mt-10 mb-12 (h2 36 → 48px, intro xs
    muted light max-w-xs right, hidden below md); grid-cols-12 gap-3 / md:gap-5.
    Captions bottom-5 (first: bottom-6) in hsl(36 22% 92%): number serif
    italic base (first: xl), label 11px 0.4em uppercase; gradient to
    hsla(24 18% 8% / .5) from 55% (first: .55 from 50%). Hover zoom 1.03, 1400ms.
  */
  .lookbook {
    padding-block: var(--space-20);
  }

  .lookbook__inner {
    max-width: var(--container-7xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .lookbook__divider {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-block: var(--space-2);
  }

  .lookbook__rule {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .eyebrow.lookbook__eyebrow {
    flex-shrink: 0;
    font-weight: var(--weight-regular);
  }

  .lookbook__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-6);
    margin-block: var(--space-10) var(--space-12);
  }

  .lookbook__heading {
    font-size: var(--text-36);
    letter-spacing: -0.025em;
  }

  .lookbook__heading em {
    font-style: italic;
  }

  .lookbook__intro {
    display: none;
    max-width: 20rem;
    font-size: var(--text-12);
    font-weight: var(--weight-light);
    text-align: right;
    color: var(--color-muted-foreground);
  }

  .lookbook__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    margin: 0;
  }

  .lookbook__item {
    --look-shade-start: 55%;
    --look-shade: 50%;

    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: color-mix(in srgb, var(--color-muted) 50%, var(--color-background));
  }

  .lookbook__item:nth-child(1) {
    --look-shade-start: 50%;
    --look-shade: 55%;

    aspect-ratio: 4 / 5;
  }

  .lookbook__item:nth-child(2),
  .lookbook__item:nth-child(3) {
    aspect-ratio: 4 / 3;
  }

  .lookbook__figure {
    position: absolute;
    inset: 0;
    margin: 0;
  }

  .lookbook__figure > .lookbook__picture,
  .lookbook__figure > .picture__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .lookbook__picture > img {
    object-position: var(--look-position);
    transition: transform var(--duration-slow) var(--ease-standard);
  }

  .lookbook__item:hover .lookbook__picture > img {
    transform: scale(1.03);
  }

  .lookbook__shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      transparent var(--look-shade-start),
      color-mix(in srgb, var(--color-hero-background) var(--look-shade), transparent) 100%
    );
  }

  .lookbook__caption {
    position: absolute;
    inset-inline: var(--space-5);
    inset-block-end: var(--space-5);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    color: color-mix(in srgb, var(--color-hero-foreground) 60%, var(--color-background));
    pointer-events: none;
  }

  .lookbook__item:nth-child(1) .lookbook__caption {
    inset-inline: var(--space-6);
    inset-block-end: var(--space-6);
  }

  .lookbook__number {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-16);
  }

  .lookbook__item:nth-child(1) .lookbook__number {
    font-size: var(--text-20);
  }

  .lookbook__label {
    font-size: var(--text-11);
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
    text-align: right;
  }

  .lookbook__link {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .lookbook__link:focus-visible {
    outline-offset: -4px;
  }

  @media (min-width: 48rem) {
    .lookbook__heading {
      font-size: var(--text-48);
    }

    .lookbook__intro {
      display: block;
    }

    .lookbook__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--space-5);
    }

    .lookbook__item {
      grid-column: span 4;
    }

    .lookbook__item:nth-child(1) {
      grid-column: 1 / span 7;
      grid-row: span 2;
    }

    /* Looks 2–3 share the feature's height (the source's grid-rows-2 stack) */
    .lookbook__item:nth-child(2),
    .lookbook__item:nth-child(3) {
      grid-column: 8 / span 5;
      aspect-ratio: auto;
    }

    .lookbook__item:nth-child(1):last-child {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }

  /* Source: each look fades in and rises 24px once in view */
  @keyframes lookbook-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  @keyframes lookbook-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .lookbook__header {
        animation: lookbook-fade linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 25%;
      }

      .lookbook__item {
        animation: lookbook-in linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 25%;
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.lookbook_grid.name",
  "tag": "div",
  "class": "section-lookbook-grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.lookbook_grid.settings.eyebrow.label",
      "default": "The Lookbook"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "In the"
    },
    {
      "type": "text",
      "id": "heading_em",
      "label": "t:sections.lookbook_grid.settings.heading_em.label",
      "info": "t:sections.lookbook_grid.settings.heading_em.info",
      "default": "field."
    },
    {
      "type": "text",
      "id": "intro",
      "label": "t:sections.lookbook_grid.settings.intro.label",
      "info": "t:sections.lookbook_grid.settings.intro.info",
      "default": "Shot among the teasels and meadows of Northern California."
    }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "t:sections.lookbook_grid.blocks.look.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "t:labels.alt_text",
          "info": "t:labels.alt_text_info"
        },
        {
          "type": "text",
          "id": "position",
          "label": "t:sections.lookbook_grid.blocks.look.settings.position.label",
          "info": "t:sections.lookbook_grid.blocks.look.settings.position.info",
          "default": "center"
        },
        {
          "type": "text",
          "id": "number",
          "label": "t:sections.lookbook_grid.blocks.look.settings.number.label",
          "default": "No. 01"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:sections.lookbook_grid.blocks.look.settings.caption.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.lookbook_grid.blocks.look.settings.link.label"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.lookbook_grid.blocks.look.settings.link_label.label",
          "info": "t:sections.lookbook_grid.blocks.look.settings.link_label.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.lookbook_grid.name",
      "blocks": [
        { "type": "look", "settings": { "number": "No. 01" } },
        { "type": "look", "settings": { "number": "No. 02" } },
        { "type": "look", "settings": { "number": "No. 03" } },
        { "type": "look", "settings": { "number": "No. 04" } },
        { "type": "look", "settings": { "number": "No. 05" } },
        { "type": "look", "settings": { "number": "No. 06" } }
      ]
    }
  ]
}
{% endschema %}
