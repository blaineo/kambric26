{% comment %}
  Journal index (Phase 4): intro header, a 2/3-column grid of article cards
  and pagination. Used on `templates/blog.json` for the `journal` blog
  (D-16: Shopify serves it at `/blogs/journal`).

  Cards: cover image (4:3), category = the article's first tag (give each
  journal post exactly one tag — its category — since Shopify sorts tags
  alphabetically and a second tag could outrank it), `<time datetime>`,
  title, excerpt. The first row (first 3 cards) loads eager; the rest lazy.
  Never `priority` — this page's `<h1>` sits above the grid, not an image.

  Empty state: no articles yet → configurable heading + a link back to the
  shop, and the whole page should be `noindex` (SEO.md: "noindex, follow
  until at least one post exists"). That needs a `snippets/meta-tags.liquid`
  change this phase doesn't own; see the phase report for the exact diff.

  No CollectionPage/Blog JSON-LD here — SEO.md lists no schema for `/journal`
  itself. Article JSON-LD lives on the article page via
  `snippets/structured-data.liquid` (`article | structured_data`).

  @setting {text} eyebrow - Small label above the heading (default "Kambric Goods")
  @setting {text} heading - First heading line (default "The")
  @setting {text} heading_em - Italic second line (default "Journal")
  @setting {richtext} body - Intro copy under the heading
  @setting {range} articles_per_page - Cards per page (default 9)
  @setting {text} empty_heading - Shown when the blog has no articles
  @setting {text} empty_cta_label - Empty-state link label
  @setting {url} empty_cta_url - Empty-state link destination (default all products)
{% endcomment %}
{%- liquid
  assign per_page = section.settings.articles_per_page | default: 9
-%}
<div class="main-blog">
  <div class="main-blog__intro">
    {%- render 'breadcrumbs' -%}
    {%- if section.settings.eyebrow != blank -%}
      {%- render 'eyebrow', text: section.settings.eyebrow, class: 'main-blog__eyebrow' -%}
    {%- endif -%}
    {%- render 'section-heading',
      heading: section.settings.heading,
      heading_em: section.settings.heading_em,
      tag: 'h1',
      size: 'hero',
      class: 'main-blog__heading'
    -%}
    {%- if section.settings.body != blank -%}
      <div class="main-blog__body">
        {%- render 'rte', content: section.settings.body -%}
      </div>
    {%- endif -%}
  </div>

  {%- paginate blog.articles by per_page -%}
    {%- if blog.articles.size > 0 -%}
      <ul class="main-blog__grid" role="list">
        {%- for article in blog.articles -%}
          {%- liquid
            assign card_loading = 'lazy'
            if forloop.index0 < 3
              assign card_loading = 'eager'
            endif
            assign category = article.tags.first
          -%}
          <li class="main-blog__item">
            <a class="main-blog__card" href="{{ article.url }}">
              <div class="main-blog__media">
                {%- if article.image -%}
                  {%- render 'picture',
                    image: article.image,
                    sizes: '(min-width: 64rem) calc((100vw - 8rem) / 3), (min-width: 48rem) calc((100vw - 8rem) / 2), calc(100vw - 4rem)',
                    widths: '360, 480, 600, 720, 900',
                    aspect_ratio: 1.3333,
                    loading: card_loading,
                    alt: '',
                    class: 'main-blog__picture picture--cover'
                  -%}
                {%- endif -%}
              </div>
              <div class="main-blog__meta">
                {%- if category != blank -%}
                  <p class="main-blog__category">{{ category }}</p>
                {%- endif -%}
                <p class="main-blog__date">{{ article.published_at | time_tag: format: 'date' }}</p>
              </div>
              <h2 class="main-blog__title">{{ article.title }}</h2>
              {%- if article.excerpt != blank -%}
                <p class="main-blog__excerpt">{{ article.excerpt }}</p>
              {%- endif -%}
              <p class="main-blog__read-more">
                {{ 'journal.read_story' | t }}<span aria-hidden="true"> &rarr;</span>
              </p>
            </a>
          </li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        <nav class="main-blog__pagination" aria-label="{{ 'collections.pagination.label' | t }}">
          <ul class="main-blog__pages" role="list">
            {%- if paginate.previous -%}
              <li>
                <a class="main-blog__page main-blog__page--step" href="{{ paginate.previous.url }}">
                  <span aria-hidden="true">&larr;</span>
                  {{ 'collections.pagination.previous' | t -}}
                </a>
              </li>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              <li>
                {%- if part.is_link -%}
                  <a class="main-blog__page" href="{{ part.url }}">
                    <span class="visually-hidden">{{ 'collections.pagination.page' | t: number: part.title }}</span>
                    <span aria-hidden="true">{{ part.title }}</span>
                  </a>
                {%- elsif part.title == paginate.current_page -%}
                  <span class="main-blog__page main-blog__page--current" aria-current="page">
                    <span class="visually-hidden">{{ 'collections.pagination.page' | t: number: part.title }}</span>
                    <span aria-hidden="true">{{ part.title }}</span>
                  </span>
                {%- else -%}
                  <span class="main-blog__page">{{ part.title }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
            {%- if paginate.next -%}
              <li>
                <a class="main-blog__page main-blog__page--step" href="{{ paginate.next.url }}">
                  {{- 'collections.pagination.next' | t }}
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </li>
            {%- endif -%}
          </ul>
        </nav>
      {%- endif -%}
    {%- else -%}
      <div class="main-blog__empty">
        <p class="main-blog__empty-heading">
          {{ section.settings.empty_heading | default: 'The first stories are still being written.' }}
        </p>
        {%- liquid
          assign empty_cta_label = section.settings.empty_cta_label | default: 'Shop the Collection'
          assign empty_cta_url = section.settings.empty_cta_url | default: routes.all_products_collection_url
        -%}
        {%- render 'button', label: empty_cta_label, url: empty_cta_url, variant: 'underline' -%}
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% stylesheet %}
  .main-blog {
    padding-block: var(--space-10) var(--space-24);
  }

  .main-blog__intro {
    max-width: 34rem;
    padding-inline: var(--page-margin);
    margin-block-end: var(--space-12);
  }

  .main-blog__eyebrow {
    margin-block: var(--space-6) var(--space-3);
  }

  .main-blog__body .rte {
    margin-block-start: var(--space-4);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-14);
    color: color-mix(in srgb, var(--color-foreground) 78%, transparent);
  }

  .main-blog__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6) var(--space-12);
    margin: 0;
    padding-inline: var(--page-margin);
    list-style: none;
  }

  .main-blog__card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .main-blog__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    margin-block-end: var(--space-5);
    background: var(--color-muted);
  }

  .main-blog__picture {
    position: absolute;
    inset: 0;
  }

  .main-blog__picture img {
    transition: transform var(--duration-slow) var(--ease-standard);
  }

  .main-blog__card:hover .main-blog__picture img,
  .main-blog__card:focus-visible .main-blog__picture img {
    transform: scale(1.03);
  }

  .main-blog__meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    margin-block-end: var(--space-2-5);
  }

  .main-blog__category {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--text-10);
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .main-blog__date {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--text-10);
    letter-spacing: var(--tracking-nav);
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }

  .main-blog__title {
    margin: 0 0 var(--space-2-5);
    font-family: var(--font-serif);
    font-size: var(--text-26);
    line-height: 1.1;
    letter-spacing: var(--tracking-editorial);
    transition: color var(--duration-medium) var(--ease-standard);
  }

  .main-blog__card:hover .main-blog__title {
    color: var(--color-primary);
  }

  .main-blog__excerpt {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    margin: 0;
    font-size: var(--text-14);
    font-weight: var(--weight-light);
    line-height: var(--leading-relaxed);
    color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
  }

  .main-blog__read-more {
    margin: var(--space-3) 0 0;
    font-family: var(--font-sans);
    font-size: var(--text-10);
    letter-spacing: var(--tracking-label-xs);
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-foreground) 60%, transparent);
    transition: color var(--duration-medium) var(--ease-standard);
  }

  .main-blog__card:hover .main-blog__read-more {
    color: var(--color-primary);
  }

  .main-blog__empty {
    padding-block: var(--space-24);
    padding-inline: var(--page-margin);
    text-align: center;
  }

  .main-blog__empty-heading {
    margin: 0 0 var(--space-6);
    font-family: var(--font-serif);
    font-size: var(--text-24);
    font-style: italic;
    color: var(--color-muted-foreground);
  }

  .main-blog__pagination {
    margin-block-start: var(--space-16);
  }

  .main-blog__pages {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-sans);
    font-size: var(--text-11);
    letter-spacing: var(--tracking-nav);
    text-transform: uppercase;
  }

  .main-blog__page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding-inline: var(--space-2);
    color: var(--color-muted-foreground);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  a.main-blog__page:hover {
    color: var(--color-foreground);
  }

  .main-blog__page--current {
    color: var(--color-foreground);
    border-block-end: 1px solid var(--color-foreground);
  }

  @media (min-width: 48rem) {
    .main-blog__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .main-blog__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.blog",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:general.eyebrow",
      "default": "Kambric Goods"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:general.heading",
      "default": "The"
    },
    {
      "type": "text",
      "id": "heading_em",
      "label": "t:sections.main_blog.heading_em",
      "default": "Journal"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:labels.text",
      "default": "<p>Notes from the archive — the stories behind the prints, the craft that carries them, and how we wear them now.</p>"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "t:sections.main_blog.articles_per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 9
    },
    {
      "type": "header",
      "content": "t:sections.main_blog.empty_header"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "t:general.heading",
      "default": "The first stories are still being written."
    },
    {
      "type": "text",
      "id": "empty_cta_label",
      "label": "t:labels.button_label",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "empty_cta_url",
      "label": "t:labels.link"
    }
  ]
}
{% endschema %}
