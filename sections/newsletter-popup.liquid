{% comment %}
  Site-wide newsletter pop-up (Phase 5, decision D-11 still open — see the
  schema note on `discount_code`). Source: PromoPopup.tsx, COMPONENTS.md
  "PromoPopup", BEHAVIOR.md "Back-in-stock and email capture",
  data/settings.json `code_owned_popup`, design/screenshots/email-popup-*.png.

  Native <dialog>: fixed bottom-left card on desktop, full-width bottom
  sheet on mobile (screenshots). Opens 6s (configurable) after page load
  unless localStorage `kambric_promo_dismissed` is set; closing or a
  successful signup sets it. Sign-up posts to Shopify's native customer
  form (`{% form 'customer' %}` with `contact[email]` — Shopify sets
  `accepts_marketing: true` on the resulting customer automatically,
  see shopify.dev "Email consent") tagged `newsletter,popup`.

  This section is meant to render once, site-wide, from the footer group.
  It isn't wired in here (footer-group.json is owned by another agent);
  the exact block entry to add is in the phase 5 report.

  Renders only when enabled, and only on pages matching "Show on" (or
  always in the theme editor, so it can be previewed/edited from any
  page). In the theme editor it never auto-opens on a delay: it only
  opens while its own section is selected in the sidebar
  (`shopify:section:select` / `:deselect`), so it doesn't interrupt
  editing of other sections.

  No image is requested until the dialog actually opens: the <picture>
  lives inside a <template> and is cloned into the DOM on first open, so
  it never competes for the LCP and never loads for a visitor who never
  triggers the pop-up.
{% endcomment %}

{%- liquid
  assign enabled = section.settings.enabled
  assign show_on = section.settings.show_on | default: 'all'
  assign page_ok = true
  if show_on == 'home' and request.page_type != 'index'
    assign page_ok = false
  endif
  assign should_render = false
  if enabled and page_ok
    assign should_render = true
  endif
  if enabled and request.design_mode
    assign should_render = true
  endif

  assign heading = section.settings.heading
  assign body = section.settings.body
  assign button_label = section.settings.button_label
  assign success_heading = section.settings.success_heading
  assign success_body = section.settings.success_body
  assign discount_code = section.settings.discount_code | strip
  assign delay_seconds = section.settings.delay_seconds | default: 6

  assign eyebrow_text = 'newsletter_popup.eyebrow' | t
  assign email_label = 'newsletter_popup.email_label' | t
  assign email_placeholder = 'newsletter_popup.email_placeholder' | t
  assign close_label = 'newsletter_popup.close' | t
  assign error_copy = 'newsletter_popup.error' | t
  assign code_label = 'newsletter_popup.code_label' | t

  assign heading_id = 'NewsletterPopupHeading-' | append: section.id
  assign email_id = 'NewsletterPopupEmail-' | append: section.id
  assign form_id = 'NewsletterPopupForm-' | append: section.id
  assign dialog_id = 'NewsletterPopup-' | append: section.id
-%}

{%- if should_render -%}
  <kg-promo-popup
    class="promo-popup"
    data-section-id="{{ section.id }}"
    data-design-mode="{{ request.design_mode }}"
    data-delay-seconds="{{ delay_seconds }}"
  >
    <dialog id="{{ dialog_id }}" class="promo-popup__dialog" aria-labelledby="{{ heading_id }}">
      <button
        type="button"
        class="promo-popup__close"
        data-promo-popup-close
        aria-label="{{ close_label }}"
      >
        {%- render 'icon', name: 'close' -%}
      </button>

      {%- if section.settings.image != blank -%}
        <template data-promo-popup-image-template>
          {%- render 'picture', image: section.settings.image, alt: '', sizes: '(min-width: 48rem) 330px, 100vw', loading: 'lazy', class: 'promo-popup__picture picture--cover', img_class: 'promo-popup__img' -%}
        </template>
        <div class="promo-popup__media" data-promo-popup-media hidden></div>
      {%- endif -%}

      <div class="promo-popup__body">
        {% form 'customer', id: form_id, class: 'promo-popup__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter,popup">

          <div class="promo-popup__view" data-promo-popup-view="form">
            {%- render 'eyebrow', text: eyebrow_text, class: 'promo-popup__eyebrow' -%}
            <h2 id="{{ heading_id }}" class="promo-popup__heading">{{ heading | escape }}</h2>
            {%- if body != blank -%}
              <p class="promo-popup__copy">{{ body | escape }}</p>
            {%- endif -%}

            <label class="visually-hidden" for="{{ email_id }}">{{ email_label }}</label>
            <input
              id="{{ email_id }}"
              class="promo-popup__input"
              type="email"
              name="contact[email]"
              autocomplete="email"
              required
              placeholder="{{ email_placeholder }}"
            >

            {%- render 'button', label: button_label, variant: 'outline', type: 'submit', class: 'promo-popup__submit' -%}

            <p class="promo-popup__message promo-popup__message--error" role="alert" data-promo-popup-error hidden>
              {{- error_copy -}}
            </p>
          </div>

          <div class="promo-popup__view" data-promo-popup-view="success" hidden tabindex="-1" aria-live="polite">
            <p class="promo-popup__heading promo-popup__heading--serif">{{ success_heading | escape }}</p>
            {%- if success_body != blank -%}
              <p class="promo-popup__copy">{{ success_body | escape }}</p>
            {%- endif -%}
            {%- if discount_code != blank -%}
              <div class="promo-popup__code">
                <p class="promo-popup__code-label">{{ code_label }}</p>
                <p class="promo-popup__code-value">{{ discount_code | escape }}</p>
              </div>
            {%- endif -%}
          </div>
        {% endform %}
      </div>
    </dialog>
  </kg-promo-popup>

  <script src="{{ 'component-popup.js' | asset_url }}" type="module" defer="defer"></script>
{%- endif -%}

{% stylesheet %}
  .promo-popup__dialog {
    position: fixed;
    inset: auto auto var(--space-5) var(--space-5);
    margin: 0;
    width: 20.625rem; /* 330px, source max-width */
    max-width: calc(100vw - var(--space-10));
    padding: 0;
    border: 0;
    background: var(--color-background);
    color: var(--color-foreground);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .promo-popup__dialog::backdrop {
    background: transparent;
  }

  @media (max-width: 47.99rem) {
    .promo-popup__dialog {
      inset: auto 0 0 0;
      width: 100%;
      max-width: 100%;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .promo-popup__dialog {
      opacity: 1;
      transform: none;
      transition:
        opacity var(--duration-base) var(--ease-out-expo),
        transform var(--duration-base) var(--ease-out-expo),
        display var(--duration-base) allow-discrete,
        overlay var(--duration-base) allow-discrete;
    }

    @starting-style {
      .promo-popup__dialog[open] {
        opacity: 0;
        transform: translate(-2.5rem, 1.25rem);
      }
    }
  }

  .promo-popup__close {
    position: absolute;
    top: var(--space-2-5);
    right: var(--space-2-5);
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    color: color-mix(in srgb, var(--color-foreground) 60%, transparent);
    background: color-mix(in srgb, var(--color-background) 70%, transparent);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .promo-popup__close:hover,
  .promo-popup__close:focus-visible {
    color: var(--color-foreground);
  }

  .promo-popup__media {
    width: 100%;
    height: 9rem;
    position: relative;
    overflow: hidden;
  }

  .promo-popup__media[hidden] {
    display: none;
  }

  .promo-popup__img {
    width: 100%;
    height: 100%;
  }

  .promo-popup__body {
    padding: var(--space-6);
  }

  .promo-popup__form {
    position: relative;
  }

  .promo-popup__view[hidden] {
    display: none;
  }

  .promo-popup__eyebrow {
    margin-bottom: var(--space-3);
    /* Primary alone is 4.38:1 on the card; a touch darker reaches AA (4.5:1) */
    color: color-mix(in srgb, var(--color-primary) 88%, var(--color-foreground));
  }

  .promo-popup__heading {
    margin: 0 0 var(--space-2);
    font-family: var(--font-serif);
    font-size: var(--text-26);
    font-weight: var(--weight-light);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-heading);
  }

  .promo-popup__heading--serif {
    font-style: italic;
  }

  .promo-popup__copy {
    margin: 0 0 var(--space-5);
    font-size: var(--text-14);
    font-weight: var(--weight-light);
    line-height: var(--leading-relaxed);
    color: var(--color-muted-foreground);
  }

  .promo-popup__input {
    display: block;
    width: 100%;
    margin-bottom: var(--space-3);
    padding: 0 0 var(--space-2);
    background: transparent;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-foreground) 40%, transparent);
    font-size: var(--text-14);
    font-weight: var(--weight-light);
    transition: border-color var(--duration-fast) var(--ease-standard);
  }

  .promo-popup__input::placeholder {
    color: var(--color-muted-foreground);
  }

  .promo-popup__input:focus {
    outline: none;
    border-bottom-color: var(--color-primary);
  }

  /* .btn. prefix: beats snippets/button.liquid regardless of bundle order */
  .btn.promo-popup__submit {
    display: flex;
    justify-content: center;
    width: 100%;
    text-align: center;
    margin-top: var(--space-1);
    padding: var(--space-4) var(--space-5);
  }

  .promo-popup__message {
    margin: var(--space-3) 0 0;
    font-size: var(--text-11);
    letter-spacing: var(--tracking-body);
    color: var(--color-destructive);
  }

  .promo-popup__message[hidden] {
    display: none;
  }

  .promo-popup__view[data-promo-popup-view='success'] {
    outline: none;
  }

  .promo-popup__code {
    margin-top: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px dashed color-mix(in srgb, var(--color-primary) 50%, transparent);
    background: color-mix(in srgb, var(--color-primary) 5%, transparent);
    text-align: center;
  }

  .promo-popup__code-label {
    margin: 0 0 var(--space-1-5);
    font-family: var(--font-sans);
    font-size: var(--text-10);
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }

  .promo-popup__code-value {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-22);
    letter-spacing: 0.15em;
    color: var(--color-primary);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.newsletter_popup.name",
  "tag": "div",
  "class": "section-newsletter-popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "t:sections.newsletter_popup.enabled",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:general.image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.newsletter_popup.heading",
      "default": "Take 15% off"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "t:sections.newsletter_popup.body",
      "default": "Be first to know about new prints and limited runs — and get 15% off your first order."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.newsletter_popup.button_label",
      "default": "Get 15% off"
    },
    {
      "type": "text",
      "id": "success_heading",
      "label": "t:sections.newsletter_popup.success_heading",
      "default": "You're in."
    },
    {
      "type": "textarea",
      "id": "success_body",
      "label": "t:sections.newsletter_popup.success_body",
      "default": "Use this code at checkout for 15% off your first order."
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "t:sections.newsletter_popup.discount_code",
      "info": "t:sections.newsletter_popup.discount_code_info",
      "default": "WELCOME15"
    },
    {
      "type": "range",
      "id": "delay_seconds",
      "label": "t:sections.newsletter_popup.delay_seconds",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "s",
      "default": 6
    },
    {
      "type": "select",
      "id": "show_on",
      "label": "t:sections.newsletter_popup.show_on",
      "options": [
        { "value": "all", "label": "t:sections.newsletter_popup.show_on_all" },
        { "value": "home", "label": "t:sections.newsletter_popup.show_on_home" }
      ],
      "default": "all"
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter_popup.name"
    }
  ]
}
{% endschema %}
