{% comment %}
  DEV-ONLY preview section for Phase 1 breadcrumbs testing. (resync)

  Not part of the shipped theme. Remove before launch, along with
  templates/product.phase1-breadcrumbs.json and
  templates/collection.phase1-breadcrumbs.json (see docs/MIGRATION_PLAN.md
  Phase 1 report).

  Visit on the dev theme:
    /products/<active-handle>?view=phase1-breadcrumbs
    /collections/<handle>?view=phase1-breadcrumbs
{% endcomment %}

<div class="phase1-breadcrumbs-preview">
  <p class="phase1-breadcrumbs-preview__meta">
    Phase 1 breadcrumbs preview — request.page_type: {{ request.page_type }}
  </p>
  {% render 'breadcrumbs' %}
</div>

{% stylesheet %}
  .phase1-breadcrumbs-preview {
    padding: var(--space-8) var(--space-6);
  }

  .phase1-breadcrumbs-preview__meta {
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-12);
    color: var(--color-muted-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Breadcrumbs preview (dev)",
  "settings": []
}
{% endschema %}
