{% comment %}
  DEV-ONLY preview of every Phase 1 UI primitive and theme block variant.
  Reachable at /?view=phase1-ui via templates/index.phase1-ui.json.
  Remove both files before launch (see docs/CONTENT_GUIDE.md / MIGRATION_PLAN.md Phase 1 notes).
{% endcomment %}

<div class="phase1-ui-preview">
  {%- render 'section-heading', heading: 'Phase 1', heading_em: 'UI primitives', tag: 'h1', size: 'xl' -%}
  <p class="phase1-ui-preview__intro">Dev-only preview of every snippet variant and theme block built in Phase 1. Not part of the storefront; remove before launch.</p>

  <section class="phase1-ui-preview__group">
    <h2 class="phase1-ui-preview__group-title">Buttons — snippets/button.liquid</h2>

    <h3 class="phase1-ui-preview__sub">Light background</h3>
    <div class="phase1-ui-preview__row">
      {%- render 'button', label: 'Outline', url: '#', variant: 'outline' -%}
      {%- render 'button', label: 'Solid', url: '#', variant: 'solid' -%}
      {%- render 'button', label: 'Shop the Collection', url: '#', variant: 'text-arrow' -%}
      {%- render 'button', label: 'Home', url: '#', variant: 'underline' -%}
      {%- render 'button', label: 'Large outline', url: '#', variant: 'outline', size: 'large' -%}
      {%- render 'button', label: 'No URL (button)', variant: 'solid' -%}
    </div>

    <h3 class="phase1-ui-preview__sub">On dark (hero) background</h3>
    <div class="phase1-ui-preview__row phase1-ui-preview__row--dark">
      {%- render 'button', label: 'Shop the Arielle', url: '#', variant: 'outline', on_dark: true -%}
      {%- render 'button', label: 'Shop the Collection', url: '#', variant: 'text-arrow', on_dark: true -%}
      {%- render 'button', label: 'Underline', url: '#', variant: 'underline', on_dark: true -%}
    </div>
  </section>

  <section class="phase1-ui-preview__group">
    <h2 class="phase1-ui-preview__group-title">Eyebrow — snippets/eyebrow.liquid</h2>
    <div class="phase1-ui-preview__stack">
      {%- render 'eyebrow', text: '404' -%}
      {%- render 'eyebrow', text: 'Say Hello' -%}
      {%- render 'eyebrow', text: 'New Arrivals', ornament: true -%}
    </div>
    <div class="phase1-ui-preview__row phase1-ui-preview__row--dark">
      {%- render 'eyebrow', text: 'The Archive', on_dark: true -%}
    </div>
  </section>

  <section class="phase1-ui-preview__group">
    <h2 class="phase1-ui-preview__group-title">Section heading — snippets/section-heading.liquid</h2>
    <div class="phase1-ui-preview__stack">
      {%- render 'section-heading', heading: 'Her legacy,', heading_em: 'carried on.', tag: 'h2', size: 'xl' -%}
      {%- render 'section-heading', heading: 'Contact Us', tag: 'h2', size: 'lg' -%}
      {%- render 'section-heading', heading: 'Customer Care', tag: 'h3', size: 'md' -%}
      {%- render 'section-heading', heading: 'This page seems to have wandered off.', tag: 'h3', size: 'sm', italic: true, muted: true, align: 'center' -%}
    </div>
    <div class="phase1-ui-preview__row phase1-ui-preview__row--dark">
      {%- render 'section-heading', heading: 'Arielle Slip Dress', heading_em: '', tag: 'h2', size: 'hero', on_dark: true -%}
    </div>
  </section>

  {%- comment -%}
    A `richtext` setting can't hold blockquote/table nodes, so the sample is
    hardcoded here rather than editor-controlled (this section is dev-only).
  {%- endcomment -%}
  {%- capture rte_sample -%}
    <h2>A heading</h2>
    <p>Body copy set in Jost at 16px with relaxed leading. It can hold <strong>bold</strong>, <em>italic</em> and <a href="#">an underlined link</a>.</p>
    <h3>A subheading</h3>
    <blockquote><p>A pulled quote in italic serif, the site's editorial voice.</p></blockquote>
    <ul>
      <li>Unordered list item one</li>
      <li>Unordered list item two</li>
    </ul>
    <ol>
      <li>Ordered list item one</li>
      <li>Ordered list item two</li>
    </ol>
    <table>
      <caption>Womenswear (inches)</caption>
      <thead>
        <tr><th scope="col">Size</th><th scope="col">Bust</th><th scope="col">Waist</th><th scope="col">Hip</th></tr>
      </thead>
      <tbody>
        <tr><th scope="row">XS</th><td>32&ndash;33</td><td>24&ndash;25</td><td>34&ndash;35</td></tr>
        <tr><th scope="row">S</th><td>34&ndash;35</td><td>26&ndash;27</td><td>36&ndash;37</td></tr>
        <tr><th scope="row">M</th><td>36&ndash;37</td><td>28&ndash;29</td><td>38&ndash;39</td></tr>
      </tbody>
    </table>
  {%- endcapture -%}
  <section class="phase1-ui-preview__group">
    <h2 class="phase1-ui-preview__group-title">RTE — snippets/rte.liquid</h2>
    {%- render 'rte', content: rte_sample -%}
  </section>

  <section class="phase1-ui-preview__group">
    <h2 class="phase1-ui-preview__group-title">Theme blocks (add more in the theme editor)</h2>
    <div class="phase1-ui-preview__blocks">
      {% content_for 'blocks' %}
    </div>
  </section>
</div>

{% stylesheet %}
  .phase1-ui-preview {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    max-width: var(--container-7xl);
    margin-inline: auto;
    padding: var(--space-16) var(--page-margin);
  }

  .phase1-ui-preview__intro {
    max-width: 48ch;
    color: var(--color-muted-foreground);
  }

  .phase1-ui-preview__group {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .phase1-ui-preview__group-title {
    font-family: var(--font-sans);
    font-size: var(--text-12);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label-xs);
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }

  .phase1-ui-preview__sub {
    font-family: var(--font-sans);
    font-size: var(--text-11);
    font-weight: var(--weight-light);
    color: var(--color-muted-foreground);
  }

  .phase1-ui-preview__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8);
  }

  .phase1-ui-preview__row--dark {
    padding: var(--space-8);
    background: var(--color-hero-background);
  }

  .phase1-ui-preview__stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .phase1-ui-preview__blocks {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Phase 1 UI preview",
  "blocks": [{ "type": "@theme" }],
  "settings": []
}
{% endschema %}
