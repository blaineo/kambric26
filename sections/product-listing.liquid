{% comment %}
  Product listing for collection templates: the page collection's products
  expanded into print cards (Shop.tsx, CollectionDetail.tsx, Sale.tsx).

  Two modes, chosen by whether the section has blocks:

  - Grouped (one or more "Collection" blocks; shop and category pages): each
    block is a group showing the page's print cards whose print collection is
    the block's collection. Block order is display order; empty groups are
    not rendered. A print's collection is `kambric.prints[].collection`, else
    the product's first editorial collection (product-prints.liquid). Cards
    always come from the PAGE collection (`collection.products`), so a
    category page groups only that category's products.
    "Show other pieces" (default on) lists, last, every print whose
    collection has no block (a new collection not yet added as a block, the
    stale `botanicals` handle, or no collection at all), so nothing silently
    disappears. Without "Heading for other pieces" they have no heading.
  - Single grid (no blocks; collection detail and sale pages): "Only prints
    from this collection" keeps prints whose collection is the page
    collection; "Show: prints on sale" keeps prints with compare-at > price.

  Both modes:
  - "Show these first": pinned products lead the grid / every group they
    appear in (replaces the source's hard-coded Arielle priority).
  - Pagination (D-17): by products, so cards per page vary; grouping is per page.
  - JSON-LD: one CollectionPage + nested ItemList of the rendered print cards.
  - `show_on` hides the whole section (no JSON-LD) on /collections/all or
    everywhere else, so collection.json can host the shop page too.
  - "Only this product type": for testing a category on /collections/all.
{% endcomment %}
{%- liquid
  assign show_section = false
  if collection.handle != blank
    assign show_section = true
    case section.settings.show_on
      when 'all_only'
        unless collection.handle == 'all'
          assign show_section = false
        endunless
      when 'except_all'
        if collection.handle == 'all'
          assign show_section = false
        endif
    endcase
  endif
-%}
{%- if show_section -%}
  {%- paginate collection.products by section.settings.products_per_page -%}
    {%- liquid
      assign grouped = false
      if section.blocks.size > 0
        assign grouped = true
      endif

      assign type_filter = section.settings.product_type | strip | downcase
      assign eager_count = section.settings.eager_count
      assign pinned_list = section.settings.pinned_products
      assign entry_sep = '|~|'
      assign list_sep = '|#|'

      if grouped
        assign cls = 'collection-groups'
        assign root_class = 'collection-groups full-width'
        assign card_layout = 'archive'
        assign card_sizes = '(min-width: 48rem) calc((100vw - 8.5rem) / 3), calc((100vw - 5.25rem) / 2)'
      else
        assign cls = 'collection-grid'
        assign card_layout = section.settings.card_layout
        if section.settings.container == 'full'
          assign card_sizes = '(min-width: 48rem) calc((100vw - 8.5rem) / 3), calc((100vw - 5.25rem) / 2)'
          assign root_class = 'collection-grid collection-grid--full full-width'
        else
          assign card_sizes = '(min-width: 80rem) 24rem, (min-width: 48rem) calc((100vw - 7rem) / 3), calc((100vw - 4.5rem) / 2)'
          assign root_class = 'collection-grid collection-grid--page'
        endif
      endif

      comment
        Products on this page that can be listed here (visibility guard,
        optional product type filter), and the pinned ones among them.
      endcomment
      assign page_ids = ','
      for product in collection.products
        if product.tags contains 'hidden' or product.handle == 'chainstitch-monogram'
          continue
        endif
        if type_filter != blank
          assign product_type = product.type | strip | downcase
          if product_type != type_filter
            continue
          endif
        endif
        assign page_ids = page_ids | append: product.id | append: ','
      endfor

      assign pinned_ids = ','
      for product in pinned_list
        assign key = ',' | append: product.id | append: ','
        if page_ids contains key
          assign pinned_ids = pinned_ids | append: product.id | append: ','
        endif
      endfor

      assign rendered = 0
      assign card_entries = ''
    -%}

    <div class="{{ root_class }}">
      {%- if grouped -%}
        {%- liquid
          comment
            Collection blocks, in block order. A block without a collection,
            pointing at `all`/`frontpage`, or repeating an earlier block's
            collection renders nothing (and doesn't count as covered twice).
          endcomment
          assign covered = ','
        -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign group_collection = block.settings.collection
            assign group_handle = group_collection.handle
            if group_handle == blank or group_handle == 'all' or group_handle == 'frontpage'
              continue
            endif
            assign handle_key = ',' | append: group_handle | append: ','
            if covered contains handle_key
              continue
            endif
            assign covered = covered | append: group_handle | append: ','

            assign group_count = 0
            capture group_cards
              for pass in (1..2)
                if pass == 1
                  assign pass_products = pinned_list
                else
                  assign pass_products = collection.products
                endif
                for product in pass_products
                  assign key = ',' | append: product.id | append: ','
                  unless page_ids contains key
                    continue
                  endunless
                  if pass == 2 and pinned_ids contains key
                    continue
                  endif

                  capture cards
                    render 'product-prints', product: product, collection_handle: group_handle, layout: card_layout, sizes: card_sizes, eager_count: eager_count, offset: rendered, item_class: 'collection-groups__item'
                  endcapture
                  assign count = cards | split: 'data-print-card' | size | minus: 1
                  if count > 0
                    echo cards
                    assign rendered = rendered | plus: count
                    assign group_count = group_count | plus: count

                    capture values
                      render 'product-prints', product: product, collection_handle: group_handle, output: 'values'
                    endcapture
                    assign value_list = values | split: '|'
                    for raw_value in value_list
                      assign clean_value = raw_value | strip
                      assign card_entries = card_entries | append: list_sep | append: product.id | append: entry_sep | append: clean_value
                    endfor
                  endif
                endfor
              endfor
            endcapture
          -%}
          {%- if group_count > 0 -%}
            {%- liquid
              assign heading_id = 'CollectionGroup-' | append: section.id | append: '-' | append: group_handle
              assign group_heading = block.settings.heading | strip | default: group_collection.title
              assign group_description = ''
              if block.settings.show_description
                assign group_description = group_collection.description | strip_html | strip
              endif
            -%}
            <section class="collection-groups__group" aria-labelledby="{{ heading_id }}"{{ block.shopify_attributes | prepend: ' ' | rstrip }}>
              <div class="collection-groups__header">
                <div class="collection-groups__intro">
                  <h2 class="collection-groups__heading" id="{{ heading_id }}">{{ group_heading | escape }}</h2>
                  {%- if group_description != blank -%}
                    <p class="collection-groups__description">{{ group_description }}</p>
                  {%- endif -%}
                </div>
                {%- if block.settings.show_count -%}
                  <p class="collection-groups__count">{{ 'collections.card.pieces' | t: count: group_count }}</p>
                {%- endif -%}
              </div>
              <ul class="collection-groups__grid" role="list">
                {{- group_cards -}}
              </ul>
            </section>
          {%- endif -%}
        {%- endfor -%}

        {%- if section.settings.show_other -%}
          {%- liquid
            comment
              "Other pieces": prints whose collection has no block (or that
              have no collection), pinned products first. Print collection
              resolution mirrors product-prints.liquid.
            endcomment
            assign other_count = 0
            capture other_cards
              for pass in (1..2)
                if pass == 1
                  assign pass_products = pinned_list
                else
                  assign pass_products = collection.products
                endif
                for product in pass_products
                  assign key = ',' | append: product.id | append: ','
                  unless page_ids contains key
                    continue
                  endunless
                  if pass == 2 and pinned_ids contains key
                    continue
                  endif

                  assign default_collection = ''
                  for c in product.collections
                    if c.handle != 'frontpage' and c.handle != 'all' and c.template_suffix != 'category' and c.template_suffix != 'sale'
                      assign default_collection = c.handle
                      break
                    endif
                  endfor

                  assign print_option = nil
                  for option in product.options_with_values
                    if option.name == 'Print' or option.name == 'Colorway'
                      assign print_option = option
                      break
                    endif
                  endfor
                  if print_option
                    assign print_values = print_option.values
                  else
                    assign single_print = product.metafields.kambric.print_name.value | default: product.title
                    assign print_values = single_print | split: '|||'
                  endif
                  assign prints_meta = product.metafields.kambric.prints.value

                  for value in print_values
                    assign print_value = value.name | default: value
                    assign print_collection = default_collection
                    if print_option
                      for entry in prints_meta
                        if entry.value == print_value and entry.collection != blank
                          assign print_collection = entry.collection
                          break
                        endif
                      endfor
                    endif
                    if print_collection != blank
                      assign handle_key = ',' | append: print_collection | append: ','
                      if covered contains handle_key
                        continue
                      endif
                    endif

                    assign card_loading = 'lazy'
                    if rendered < eager_count
                      assign card_loading = 'eager'
                    endif
                    echo '<li class="collection-groups__item" data-print-card>'
                    render 'product-card', product: product, print: print_value, layout: card_layout, sizes: card_sizes, loading: card_loading
                    echo '</li>'
                    assign rendered = rendered | plus: 1
                    assign other_count = other_count | plus: 1
                    assign card_entries = card_entries | append: list_sep | append: product.id | append: entry_sep | append: print_value
                  endfor
                endfor
              endfor
            endcapture
          -%}
          {%- if other_count > 0 -%}
            {%- if section.settings.other_heading != blank -%}
              {%- assign heading_id = 'CollectionGroup-' | append: section.id | append: '-other' -%}
              <section class="collection-groups__group" aria-labelledby="{{ heading_id }}">
                <div class="collection-groups__header">
                  <div class="collection-groups__intro">
                    <h2 class="collection-groups__heading" id="{{ heading_id }}">{{ section.settings.other_heading | escape }}</h2>
                  </div>
                  <p class="collection-groups__count">{{ 'collections.card.pieces' | t: count: other_count }}</p>
                </div>
                <ul class="collection-groups__grid" role="list">
                  {{- other_cards -}}
                </ul>
              </section>
            {%- else -%}
              <div class="collection-groups__group">
                <ul class="collection-groups__grid" role="list">
                  {{- other_cards -}}
                </ul>
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- else -%}
        {%- liquid
          assign print_filter = blank
          if section.settings.print_filter == 'sale'
            assign print_filter = 'sale'
          endif
          assign print_collection = blank
          if section.settings.match_collection
            assign print_collection = collection.handle
          endif
          assign card_heading_level = 3
          if section.settings.label == blank
            assign card_heading_level = 2
          endif

          capture grid_cards
            for pass in (1..2)
              if pass == 1
                assign pass_products = pinned_list
              else
                assign pass_products = collection.products
              endif
              for product in pass_products
                assign key = ',' | append: product.id | append: ','
                unless page_ids contains key
                  continue
                endunless
                if pass == 2 and pinned_ids contains key
                  continue
                endif

                capture cards
                  render 'product-prints', product: product, collection_handle: print_collection, filter: print_filter, layout: card_layout, heading_level: card_heading_level, sizes: card_sizes, eager_count: eager_count, offset: rendered, item_class: 'collection-grid__item'
                endcapture
                assign count = cards | split: 'data-print-card' | size | minus: 1
                if count > 0
                  echo cards
                  assign rendered = rendered | plus: count

                  capture values
                    render 'product-prints', product: product, collection_handle: print_collection, filter: print_filter, output: 'values'
                  endcapture
                  assign value_list = values | split: '|'
                  for raw_value in value_list
                    assign clean_value = raw_value | strip
                    assign card_entries = card_entries | append: list_sep | append: product.id | append: entry_sep | append: clean_value
                  endfor
                endif
              endfor
            endfor
          endcapture
        -%}
        {%- if section.settings.label != blank -%}
          <h2 class="collection-grid__label">{{ section.settings.label | escape }}</h2>
        {%- endif -%}
        {%- if rendered > 0 -%}
          <ul class="collection-grid__list" role="list">
            {{- grid_cards -}}
          </ul>
        {%- endif -%}
      {%- endif -%}

      {%- if rendered == 0 -%}
        <div class="{{ cls }}__empty">
          {%- if section.settings.empty_heading != blank -%}
            <p class="{{ cls }}__empty-heading">{{ section.settings.empty_heading | escape }}</p>
          {%- endif -%}
          {%- if section.settings.empty_body != blank -%}
            <div class="{{ cls }}__empty-body">{{ section.settings.empty_body }}</div>
          {%- endif -%}
          {%- if section.settings.empty_link_label != blank and section.settings.empty_link_url != blank -%}
            <a class="{{ cls }}__empty-link" href="{{ section.settings.empty_link_url }}">
              {{- section.settings.empty_link_label | escape -}}
              <span aria-hidden="true"> &rarr;</span>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="{{ cls }}__pagination" aria-label="{{ 'collections.pagination.label' | t }}">
          <ul class="{{ cls }}__pages" role="list">
            {%- if paginate.previous -%}
              <li>
                <a class="{{ cls }}__page {{ cls }}__page--step" href="{{ paginate.previous.url }}">
                  <span aria-hidden="true">&larr;</span>
                  {{ 'collections.pagination.previous' | t -}}
                </a>
              </li>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              <li>
                {%- if part.is_link -%}
                  <a class="{{ cls }}__page" href="{{ part.url }}">
                    <span class="visually-hidden">{{ 'collections.pagination.page' | t: number: part.title }}</span>
                    <span aria-hidden="true">{{ part.title }}</span>
                  </a>
                {%- elsif part.title == paginate.current_page -%}
                  <span class="{{ cls }}__page {{ cls }}__page--current" aria-current="page">
                    <span class="visually-hidden">{{ 'collections.pagination.page' | t: number: part.title }}</span>
                    <span aria-hidden="true">{{ part.title }}</span>
                  </span>
                {%- else -%}
                  <span class="{{ cls }}__page">{{ part.title }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
            {%- if paginate.next -%}
              <li>
                <a class="{{ cls }}__page {{ cls }}__page--step" href="{{ paginate.next.url }}">
                  {{- 'collections.pagination.next' | t }}
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </li>
            {%- endif -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>

    {%- if section.settings.structured_data -%}
      {%- liquid
        comment
          ItemList of the rendered cards, in page order. Merged products link
          to the print's first available variant (?variant=), single-print
          products to the product page.
        endcomment
        assign card_list = card_entries | split: list_sep
        assign items = ''
        assign position = 0
        for entry in card_list
          if entry == blank
            continue
          endif
          assign entry_parts = entry | split: entry_sep
          assign entry_id = entry_parts[0]
          assign print_value = entry_parts[1]
          for product in collection.products
            assign product_id = product.id | append: ''
            if product_id != entry_id
              continue
            endif

            assign print_index = -1
            for option in product.options_with_values
              if option.name == 'Print' or option.name == 'Colorway'
                assign print_index = option.position | minus: 1
                break
              endif
            endfor
            assign item_url = request.origin | append: product.url
            if print_index >= 0
              assign item_variant = nil
              for variant in product.variants
                if variant.options[print_index] == print_value
                  if item_variant == nil
                    assign item_variant = variant
                  endif
                  if variant.available
                    assign item_variant = variant
                    break
                  endif
                endif
              endfor
              if item_variant
                assign item_url = item_url | append: '?variant=' | append: item_variant.id
              endif
            endif

            assign item_name = product.title
            if print_value != blank and print_value != product.title
              assign item_name = item_name | append: ' — ' | append: print_value
            endif

            assign position = position | plus: 1
            assign name_json = item_name | json
            assign url_json = item_url | json
            if position > 1
              assign items = items | append: ','
            endif
            assign items = items | append: '{"@type":"ListItem","position":' | append: position | append: ',"name":' | append: name_json | append: ',"url":' | append: url_json | append: '}'
            break
          endfor
        endfor

        assign page_description = collection.description | strip_html | strip
        assign page_name = collection.title
        if collection.handle == 'all'
          assign page_name = 'collections.structured_data.all_name' | t
        endif
        assign list_name = 'collections.structured_data.item_list_name' | t: collection: page_name, shop: shop.name
      -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "CollectionPage",
          "name": {{ page_name | json }},
          {%- if page_description != blank %}
            "description": {{ page_description | json }},
          {%- endif %}
          "url": {{ canonical_url | json }}
          {%- if position > 0 -%}
            ,
            "mainEntity": {
              "@type": "ItemList",
              "name": {{ list_name | json }},
              "numberOfItems": {{ position }},
              "itemListElement": [{{ items }}]
            }
          {%- endif %}
        }
      </script>
    {%- endif -%}
  {%- endpaginate -%}
{%- endif -%}

{% stylesheet %}
  /*
    Grouped mode (Shop.tsx): page padding px-8 / md:px-12, py-10 pb-20;
    groups space-y-16; header mb-7 pb-4 border-b border-border/40;
    grid 2 → 3 columns, gap-5.
  */
  .collection-groups {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    padding: var(--space-10) var(--space-8) var(--space-20);
  }

  .collection-groups__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-block-end: var(--space-7);
    padding-block-end: var(--space-4);
    border-block-end: 1px solid color-mix(in srgb, var(--color-border) 40%, transparent);
  }

  .collection-groups__intro {
    max-width: 40rem;
  }

  .collection-groups__heading {
    font-family: var(--font-serif);
    font-size: var(--text-30);
    font-weight: var(--weight-regular);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-heading);
    color: var(--color-primary);
  }

  .collection-groups__description,
  .collection-groups__count {
    font-family: var(--font-serif);
    font-size: 0.8125rem;
    font-style: italic;
  }

  .collection-groups__description {
    margin-block-start: var(--space-3);
    line-height: 1.7;
    color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
  }

  .collection-groups__count {
    display: none;
    margin-inline-start: var(--space-6);
    white-space: nowrap;
    color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
  }

  .collection-groups__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
    Single-grid mode. Page container (CollectionDetail.tsx): max-w-7xl px-6,
    py-16 pb-28, "The Pieces" divider mb-14, grid gap-6 / md:gap-8, standard
    cards. Full container (Sale.tsx): px-8 / md:px-12, py-10 pb-20, gap-5.
  */
  .collection-grid--page {
    padding-block: var(--space-16) calc(var(--space-24) + var(--space-4));
  }

  .collection-grid--full {
    padding: var(--space-10) var(--space-8) var(--space-20);
  }

  .collection-grid__label {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-block-end: calc(var(--space-12) + var(--space-2));
    font-family: var(--font-sans);
    font-size: var(--text-11);
    font-weight: var(--weight-regular);
    line-height: 1rem;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }

  .collection-grid__label::before,
  .collection-grid__label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: color-mix(in srgb, var(--color-border) 60%, transparent);
  }

  .collection-grid__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .collection-grid--full .collection-grid__list {
    gap: var(--space-5);
  }

  /*
    Empty states: "Nothing in this category yet." (grouped),
    "No pieces yet." / "No pieces are on sale right now." (single grid).
  */
  .collection-groups__empty {
    padding-block: var(--space-24);
    text-align: center;
  }

  .collection-grid__empty {
    padding-block: calc(var(--space-24) + var(--space-4));
    text-align: center;
  }

  .collection-grid--full .collection-grid__empty {
    padding-block: var(--space-24);
  }

  .collection-groups__empty-heading {
    font-family: var(--font-serif);
    font-size: var(--text-24);
    font-style: italic;
    color: color-mix(in srgb, var(--color-foreground) 65%, transparent);
  }

  .collection-grid__empty-heading {
    font-family: var(--font-serif);
    font-size: var(--text-30);
    font-style: italic;
    color: var(--color-muted-foreground);
  }

  .collection-grid--full .collection-grid__empty-heading {
    font-size: var(--text-24);
    color: color-mix(in srgb, var(--color-foreground) 65%, transparent);
  }

  .collection-groups__empty-body,
  .collection-grid__empty-body {
    font-size: var(--text-14);
    font-weight: var(--weight-light);
    color: var(--color-muted-foreground);
  }

  .collection-groups__empty-body {
    margin-block-start: var(--space-4);
  }

  .collection-grid__empty-body {
    margin-block-start: var(--space-6);
  }

  .collection-groups__empty-link,
  .collection-grid__empty-link {
    display: inline-block;
    margin-block-start: var(--space-6);
    padding-block-end: var(--space-0-5);
    font-family: var(--font-sans);
    font-size: var(--text-11);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
    color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
    border-block-end: 1px solid color-mix(in srgb, var(--color-border) 50%, transparent);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .collection-groups__empty-link:hover,
  .collection-grid__empty-link:hover {
    color: var(--color-foreground);
  }

  /* Pagination (both modes) */
  .collection-grid__pagination {
    margin-block-start: var(--space-16);
  }

  .collection-groups__pages,
  .collection-grid__pages {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-sans);
    font-size: var(--text-11);
    letter-spacing: var(--tracking-nav);
    text-transform: uppercase;
  }

  .collection-groups__page,
  .collection-grid__page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding-inline: var(--space-2);
    color: var(--color-muted-foreground);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  a.collection-groups__page:hover,
  a.collection-grid__page:hover {
    color: var(--color-foreground);
  }

  .collection-groups__page--current,
  .collection-grid__page--current {
    color: var(--color-foreground);
    border-block-end: 1px solid var(--color-foreground);
  }

  @media (min-width: 48rem) {
    .collection-groups,
    .collection-grid--full {
      padding-inline: var(--space-12);
    }

    .collection-groups__heading {
      font-size: var(--text-36);
    }

    .collection-groups__count {
      display: block;
    }

    .collection-groups__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .collection-grid__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-8);
    }

    .collection-grid--full .collection-grid__list {
      gap: var(--space-5);
    }
  }
{% endstylesheet %}

