{% doc %}
  Collections-index card (source: Collections.tsx). One link wrapping a 4:3
  image (hover zoom + faint darkening), the collection title, a two-line
  description and the piece count (products in the collection).

  Image: collection metafield `kambric.card_image` (file reference, image),
  then the Shopify collection image / first product image
  (`collection.featured_image`), then the source's tinted gradient with the
  title in italics. Set the image's focal point in the admin to move the crop
  (the source raised it to 28% for Psychedelics and Whimsy).

  Renders nothing for the `frontpage` collection.

  @param {collection} collection - The collection
  @param {string} [loading] - Image loading: 'lazy' (default) | 'eager' | 'priority'
  @param {string} [sizes] - Image `sizes` (default: 1 column, 2 from 48rem, max-w-7xl)
  @param {number} [heading_level] - Heading level for the title (default 2, as in the source)
  @param {boolean} [show_season] - Show `kambric.season` (fallback `kambric.year`) as an eyebrow above the title. Default false: the source card doesn't show it.

  @example
  {% render 'collection-card', collection: collection, loading: 'eager' %}
{% enddoc %}
{%- if collection != blank and collection.handle != 'frontpage' -%}
  {%- liquid
    assign heading_level = heading_level | default: 2
    assign loading = loading | default: 'lazy'
    assign sizes = sizes | default: '(min-width: 80rem) 592px, (min-width: 48rem) calc(50vw - 3rem), calc(100vw - 3rem)'

    assign card_image = nil
    assign card_file = collection.metafields.kambric.card_image.value
    if card_file.preview_image
      assign card_image = card_file.preview_image
    elsif card_file.width
      assign card_image = card_file
    endif
    if card_image == nil
      assign card_image = collection.featured_image
    endif

    assign eyebrow = nil
    if show_season
      assign eyebrow = collection.metafields.kambric.season.value | default: collection.metafields.kambric.year.value
    endif

    assign description = collection.description | strip_html | strip
  -%}
  <a class="collection-card" href="{{ collection.url }}">
    <div class="collection-card__media">
      {%- if card_image -%}
        {%- render 'picture',
          image: card_image,
          sizes: sizes,
          widths: '360, 540, 720, 900, 1080, 1200',
          aspect_ratio: 1.3333,
          loading: loading,
          alt: '',
          class: 'collection-card__picture picture--cover'
        -%}
      {%- else -%}
        <span class="collection-card__placeholder" aria-hidden="true">{{ collection.title }}</span>
      {%- endif -%}
    </div>
    <div class="collection-card__info">
      <div class="collection-card__text">
        {%- if eyebrow != blank -%}
          <p class="collection-card__eyebrow">{{ eyebrow }}</p>
        {%- endif -%}
        <h{{ heading_level }} class="collection-card__title">{{ collection.title }}</h{{ heading_level }}>
        {%- if description != blank -%}
          <p class="collection-card__description">{{ description }}</p>
        {%- endif -%}
      </div>
      <p class="collection-card__count">
        {{- 'collections.card.pieces' | t: count: collection.products_count -}}
      </p>
    </div>
  </a>
{%- endif -%}

{% stylesheet %}
  .collection-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .collection-card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    margin-block-end: var(--space-5);
    background: color-mix(in srgb, var(--color-muted) 30%, transparent);
  }

  .collection-card__media > .collection-card__picture {
    position: absolute;
    inset: 0;
  }

  .collection-card__picture > img {
    transition: transform 700ms var(--ease-standard);
  }

  .collection-card:hover .collection-card__picture > img,
  .collection-card:focus-visible .collection-card__picture > img {
    transform: scale(1.05);
  }

  .collection-card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--color-foreground) 0%, transparent);
    transition: background-color var(--duration-base) var(--ease-standard);
    pointer-events: none;
  }

  .collection-card:hover .collection-card__media::after {
    background: color-mix(in srgb, var(--color-foreground) 5%, transparent);
  }

  .collection-card__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: var(--space-8);
    background: linear-gradient(
      to bottom right,
      color-mix(in srgb, var(--color-muted) 80%, transparent),
      color-mix(in srgb, var(--color-accent) 30%, transparent)
    );
    font-family: var(--font-serif);
    font-size: var(--text-36);
    font-style: italic;
    line-height: var(--leading-tight);
    color: color-mix(in srgb, var(--color-foreground) 65%, transparent);
  }

  .collection-card__info {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .collection-card__eyebrow {
    margin-block-end: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--text-10);
    letter-spacing: var(--tracking-footer);
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }

  .collection-card__title {
    margin-block-end: var(--space-1);
    font-family: var(--font-serif);
    font-size: var(--text-24);
    font-weight: var(--weight-regular);
    line-height: 2rem;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .collection-card:hover .collection-card__title {
    color: var(--color-primary);
  }

  .collection-card__description {
    display: -webkit-box;
    max-width: 24rem;
    margin-block-start: var(--space-2);
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    font-size: var(--text-14);
    line-height: 1.25rem;
    color: var(--color-muted-foreground);
  }

  .collection-card__count {
    flex-shrink: 0;
    margin-inline-start: var(--space-4);
    padding-block-start: var(--space-1);
    font-size: var(--text-12);
    line-height: 1rem;
    color: var(--color-muted-foreground);
  }
{% endstylesheet %}
