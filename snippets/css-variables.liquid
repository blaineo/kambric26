{% doc %}
  Emits the editor-controlled design tokens (colors) as CSS custom properties.
  Static tokens (spacing, type, containers, motion) live in assets/critical.css.
  Defaults come from the export's design/tokens.json (HSL converted to hex).
{% enddoc %}
{% style %}
  :root {
    --color-background: {{ settings.color_background }};
    --color-foreground: {{ settings.color_foreground }};
    --color-border: {{ settings.color_border }};
    --color-input: {{ settings.color_border }};
    --color-ring: {{ settings.color_primary }};
    --color-primary: {{ settings.color_primary }};
    --color-primary-foreground: {{ settings.color_primary_foreground }};
    --color-secondary: {{ settings.color_secondary }};
    --color-secondary-foreground: {{ settings.color_secondary_foreground }};
    --color-accent: {{ settings.color_accent }};
    --color-accent-foreground: {{ settings.color_accent_foreground }};
    --color-muted: {{ settings.color_muted }};
    --color-muted-foreground: {{ settings.color_muted_foreground }};
    --color-hero-background: {{ settings.color_hero_background }};
    --color-hero-foreground: {{ settings.color_hero_foreground }};
    /* Light gold for italic accents on dark heroes (source: hsl(34 44% 62%), the primary hue lifted to 62% lightness) */
    --color-hero-accent: hsl(34 44% 62%);
    --color-hero-accent: hsl(from var(--color-primary) h s 62%);
    --color-destructive: {{ settings.color_destructive }};
    --logo-height: {{ settings.logo_height }}px;
    --logo-height-mobile: {{ settings.logo_height_mobile }}px;
  }
{% endstyle %}
