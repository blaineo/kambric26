{% doc %}
  Inline SVG icon. Decorative by default (aria-hidden); give the parent
  control an accessible name (visible text or aria-label / visually-hidden span).

  @param {string} name - 'search' | 'bag' | 'chevron-down' | 'instagram' | 'pinterest' | 'close'
  @param {string} [class] - Extra class on the <svg>

  @example
  {% render 'icon', name: 'search' %}
{% enddoc %}
{%- case name -%}
  {%- when 'search' -%}
    <svg class="icon icon--search {{ class }}" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7.5"/><path d="m20.5 20.5-4.2-4.2"/></svg>
  {%- when 'bag' -%}
    <svg class="icon icon--bag {{ class }}" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M16 10a4 4 0 0 1-8 0"/><path d="M3.1 6h17.8"/><path d="M3.4 5.5a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.7a2 2 0 0 0-.4-1.2l-2-2.7A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z"/></svg>
  {%- when 'chevron-down' -%}
    <svg class="icon icon--chevron {{ class }}" aria-hidden="true" focusable="false" width="8" height="5" viewBox="0 0 8 5" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"><path d="M1 1 4 4 7 1"/></svg>
  {%- when 'instagram' -%}
    <svg class="icon icon--instagram {{ class }}" aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="2.5" width="19" height="19" rx="5"/><circle cx="12" cy="12" r="4.2"/><path d="M17.5 6.5h.01"/></svg>
  {%- when 'pinterest' -%}
    <svg class="icon icon--pinterest {{ class }}" aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M11.2 8.6 7.8 22"/><path d="M8.9 15.6c.6 1 1.7 1.6 3 1.6 3.3 0 5.6-3 5.6-6.7C17.5 6.9 14.9 4 11.3 4 7.4 4 5 6.8 5 9.9c0 1.4.6 2.9 1.6 3.6"/></svg>
  {%- when 'close' -%}
    <svg class="icon icon--close {{ class }}" aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
{%- endcase -%}
