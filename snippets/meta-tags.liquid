{% doc %}
  SEO head: title, description, canonical, robots, Open Graph, Twitter card.
  Everything is derived from Shopify objects, so editors control it through
  each resource's "Search engine listing" fields in the admin.
  Structured data (JSON-LD) lives in snippets/structured-data.liquid.
{% enddoc %}
{%- liquid
  # Source parity (liquid/SEO.md): 404 title is "Page Not Found | Kambric Goods".
  if request.page_type == '404'
    assign page_title = 'general.page_not_found' | t
  endif
  # Source parity (liquid/SEO.md): journal posts are "{title} | Kambric Goods Journal".
  if request.page_type == 'article'
    assign page_title = article.title | append: ' | ' | append: shop.name | append: ' Journal'
  endif
  # Source parity: /collections/all is the shop page, titled "Shop All | Kambric Goods".
  if request.page_type == 'collection' and collection.handle == 'all' and current_tags == blank
    assign page_title = 'collections.shop_all_title' | t
  endif
  if request.page_type == 'list-collections'
    assign page_title = 'collections.index_title' | t
  endif
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  assign share_image = page_image | default: settings.share_image

  comment
    Pages that shouldn't be indexed (source parity: cart, 404 and search were noindex).
    Shopify's robots.txt also disallows /cart, /checkout, /search and /account.
  endcomment
  assign noindex = false
  case request.page_type
    when '404', 'cart', 'search', 'password', 'gift_card', 'captcha'
      assign noindex = true
  endcase
  if request.page_type contains 'customers/'
    assign noindex = true
  endif

  # Source parity: the Journal index is noindex until it has at least one post.
  if request.page_type == 'blog' and blog.articles_count == 0
    assign noindex = true
  endif

  # Products tagged `hidden` (e.g. the published chainstitch-monogram fee) are
  # never indexed. Sitemap exclusion needs the product's seo.hidden metafield
  # (store data, see docs/MIGRATION_PLAN.md §3).
  if request.page_type == 'product' and product.tags contains 'hidden'
    assign noindex = true
  endif
-%}

{%- comment -%}
  Title pattern matches the current site (liquid/SEO.md): "{Page} | Kambric Goods".
  The home title is the store's SEO title (Online Store → Preferences).
{%- endcomment -%}
<title>
  {{- page_title -}}
  {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
  {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} | {{ shop.name }}{% endunless -%}
</title>

{%- if page_description %}
  <meta name="description" content="{{ page_description | escape }}">
{%- endif %}

{%- comment -%}
  Shopify serves the home page at /shop (a reserved alias), so a URL redirect for the old
  site's /shop ("Shop All") can never fire. Send those visitors and search engines to the
  shop page instead: an instant meta refresh is treated like a redirect by Google.
{%- endcomment -%}
{%- if request.path == '/shop' -%}
  <meta http-equiv="refresh" content="0; url={{ routes.all_products_collection_url }}">
  <link rel="canonical" href="{{ request.origin }}{{ routes.all_products_collection_url }}">
{%- else -%}
  <link rel="canonical" href="{{ canonical_url }}">
{%- endif -%}

{%- if noindex %}
  <meta name="robots" content="noindex, follow">
{%- else %}
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
{%- endif %}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' }}">

{%- if share_image %}
  <meta property="og:image" content="https:{{ share_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ share_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: share_image.aspect_ratio | round }}">
  {%- if share_image.alt != blank %}
    <meta property="og:image:alt" content="{{ share_image.alt | escape }}">
  {%- endif %}
{%- else %}
  <meta property="og:image" content="https:{{ 'og-default.jpg' | asset_url }}">
  <meta property="og:image:secure_url" content="https:{{ 'og-default.jpg' | asset_url }}">
  <meta property="og:image:width" content="1280">
  <meta property="og:image:height" content="720">
{%- endif %}

{%- if request.page_type == 'product' %}
  <meta property="product:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- elsif request.page_type == 'article' %}
  <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
  <meta property="article:modified_time" content="{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
{%- endif %}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if share_image %}
  <meta name="twitter:image" content="https:{{ share_image | image_url: width: 1200 }}">
{%- else %}
  <meta name="twitter:image" content="https:{{ 'og-default.jpg' | asset_url }}">
{%- endif %}
