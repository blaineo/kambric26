{% doc %}
  SEO head: title, description, canonical, robots, Open Graph, Twitter card.
  Everything is derived from Shopify objects, so editors control it through
  each resource's "Search engine listing" fields in the admin.
  Structured data (JSON-LD) lives in snippets/structured-data.liquid.

  Sharing image (og:image / twitter:image), 1200×630, first match wins:
    1. the page's hero, marked by `snippets/share-image.liquid` inside `page_html`
       (home, About, Events and collection heroes)
    2. the product or journal-post image (Shopify's `page_image`), cropped to 1200×630
       (see share-crop-url.liquid for the crop anchor)
    3. theme setting "Social sharing image" (Theme settings → Brand), i.e. the home hero
    4. the bundled `og-default.jpg`

  @param {string} [page_html] - The rendered template (`content_for_layout`), scanned for the hero marker
{% enddoc %}
{%- liquid
  # Source parity (liquid/SEO.md): 404 title is "Page Not Found | Kambric Goods".
  if request.page_type == '404'
    assign page_title = 'general.page_not_found' | t
  endif
  # Source parity (liquid/SEO.md): journal posts are "{title} | Kambric Goods Journal".
  if request.page_type == 'article'
    assign page_title = article.title | append: ' | ' | append: shop.name | append: ' Journal'
  endif
  # Source parity: /collections/all is the shop page, titled "Shop All | Kambric Goods".
  if request.page_type == 'collection' and collection.handle == 'all' and current_tags == blank
    assign page_title = 'collections.shop_all_title' | t
  endif
  if request.page_type == 'list-collections'
    assign page_title = 'collections.index_title' | t
  endif
  # Single-print products: add the print to the default title ("Kati Slip Dress in Matyó Floral"),
  # people search print names. A title set in the product's Search engine listing wins.
  if request.page_type == 'product' and product.metafields.global.title_tag == blank
    assign title_print = product.metafields.kambric.print_name.value
    if title_print != blank
      unless product.title contains title_print
        assign page_title = product.title | append: ' in ' | append: title_print
      endunless
    endif
  endif
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  # Meta description: the page's own, else the current site's copy for pages Shopify
  # gives none (liquid/SEO.md), else the store description.
  assign meta_description = page_description
  if meta_description == blank
    case request.page_type
      when 'index'
        assign meta_description = shop.description | default: 'general.home_description' | t
      when 'list-collections'
        assign meta_description = 'collections.index_description' | t
      when 'collection'
        if collection.handle == 'all'
          assign meta_description = 'collections.shop_all_description' | t
        else
          assign meta_description = 'collections.fallback_description' | t: title: collection.title
        endif
      when 'product'
        comment
          No product description: say what it is and which prints, instead of the store blurb.
        endcomment
        assign desc_prints = product.metafields.kambric.print_name.value
        if desc_prints == blank
          for option in product.options_with_values
            if option.name == 'Print' or option.name == 'Colorway'
              assign desc_prints = option.values | join: ', '
            endif
          endfor
        endif
        if desc_prints != blank
          assign meta_description = 'products.product.fallback_description_prints' | t: title: product.title, prints: desc_prints
        else
          assign meta_description = 'products.product.fallback_description' | t: title: product.title
        endif
    endcase
  endif
  assign meta_description = meta_description | default: shop.description
  assign og_description = meta_description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  assign share_url = blank
  assign share_alt = blank
  assign marker = page_html | split: '<!-- kg-share-image: '
  if marker.size > 1
    assign share_parts = marker[1] | split: ' -->' | first | split: '|'
    assign share_url = share_parts[0] | strip
    assign share_alt = share_parts[1] | strip
  endif
  if share_url == blank
    assign share_image = page_image | default: settings.share_image
    if share_image
      capture share_url
        render 'share-crop-url', image: share_image
      endcapture
      assign share_url = share_url | strip | prepend: 'https:'
      assign share_alt = share_image.alt | escape
    endif
  endif

  comment
    Pages that shouldn't be indexed (source parity: cart, 404 and search were noindex).
    Shopify's robots.txt also disallows /cart, /checkout, /search and /account.
  endcomment
  assign noindex = false
  case request.page_type
    when '404', 'cart', 'search', 'password', 'gift_card', 'captcha'
      assign noindex = true
  endcase
  if request.page_type contains 'customers/'
    assign noindex = true
  endif

  # Source parity: the Journal index is noindex until it has at least one post.
  if request.page_type == 'blog' and blog.articles_count == 0
    assign noindex = true
  endif

  # Products tagged `hidden` (e.g. the published chainstitch-monogram fee) are
  # never indexed. Sitemap exclusion needs the product's seo.hidden metafield
  # (store data, see docs/MIGRATION_PLAN.md §3).
  if request.page_type == 'product' and product.tags contains 'hidden'
    assign noindex = true
  endif

  # Anything an editor hid from search engines (Shopify's seo.hidden = 1, which already drops it
  # from the sitemap) also gets noindex, so the two signals agree.
  case request.page_type
    when 'product'
      assign seo_hidden = product.metafields.seo.hidden.value
    when 'collection'
      assign seo_hidden = collection.metafields.seo.hidden.value
    when 'page'
      assign seo_hidden = page.metafields.seo.hidden.value
    when 'article'
      assign seo_hidden = article.metafields.seo.hidden.value
    when 'blog'
      assign seo_hidden = blog.metafields.seo.hidden.value
  endcase
  if seo_hidden == 1 or seo_hidden == '1' or seo_hidden == true
    assign noindex = true
  endif
-%}

{%- comment -%}
  Title pattern matches the current site (liquid/SEO.md): "{Page} | Kambric Goods".
  The home title is the store's SEO title (Online Store → Preferences).
{%- endcomment -%}
<title>
  {{- page_title -}}
  {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
  {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} | {{ shop.name }}{% endunless -%}
</title>

{%- if meta_description != blank %}
  <meta name="description" content="{{ meta_description | strip_html | escape_once }}">
{%- endif %}

{%- comment -%}
  Shopify serves the home page at /shop (a reserved alias), so a URL redirect for the old
  site's /shop ("Shop All") can never fire. Send those visitors and search engines to the
  shop page instead: an instant meta refresh is treated like a redirect by Google.
{%- endcomment -%}
{%- if request.path == '/shop' -%}
  <meta http-equiv="refresh" content="0; url={{ routes.all_products_collection_url }}">
  <link rel="canonical" href="{{ request.origin }}{{ routes.all_products_collection_url }}">
{%- else -%}
  <link rel="canonical" href="{{ canonical_url }}">
{%- endif -%}

{%- if noindex %}
  <meta name="robots" content="noindex, follow">
{%- else %}
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
{%- endif %}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape_once }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | strip_html | escape_once }}">
<meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' }}">

{%- if share_url != blank %}
  <meta property="og:image" content="{{ share_url }}">
  <meta property="og:image:secure_url" content="{{ share_url }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  {%- if share_alt != blank %}
    <meta property="og:image:alt" content="{{ share_alt }}">
  {%- endif %}
{%- else %}
  <meta property="og:image" content="https:{{ 'og-default.jpg' | asset_url }}">
  <meta property="og:image:secure_url" content="https:{{ 'og-default.jpg' | asset_url }}">
  <meta property="og:image:width" content="1280">
  <meta property="og:image:height" content="720">
{%- endif %}

{%- if request.page_type == 'product' %}
  <meta property="product:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- elsif request.page_type == 'article' %}
  <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
  <meta property="article:modified_time" content="{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
{%- endif %}

{%- if request.page_type == 'index' and settings.google_site_verification != blank %}
  <meta name="google-site-verification" content="{{ settings.google_site_verification | strip | escape }}">
{%- endif %}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape_once }}">
<meta name="twitter:description" content="{{ og_description | strip_html | escape_once }}">
{%- if share_url != blank %}
  <meta name="twitter:image" content="{{ share_url }}">
{%- else %}
  <meta name="twitter:image" content="https:{{ 'og-default.jpg' | asset_url }}">
{%- endif %}
