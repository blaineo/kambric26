{% doc %}
  Responsive <picture> for any Shopify image. Use this for every image in the theme.

  - srcset from Shopify CDN widths (the CDN picks AVIF/WebP per browser, so no
    format <source>s are needed); never upscales past the original width
  - explicit width/height on <img> (and <source>) so the browser reserves space → no CLS
  - optional art-directed mobile image via <source media>
  - loading strategy:
      'lazy'     (default) below-the-fold images
      'eager'    above the fold but not the LCP element (e.g. logo)
      'priority' THE LCP image (max one per page): eager + fetchpriority=high + preload
                 via our own <link> (Shopify's Link-header preload is malformed); with
                 mobile_image, one media-scoped preload per viewport

  @param {image} image - Shopify image (e.g. product.featured_image, section.settings.image)
  @param {string} sizes - The `sizes` attribute, e.g. '(min-width: 48rem) 33vw, 50vw'. Be accurate: it decides which file downloads.
  @param {string} [alt] - Alt text override. Defaults to the image's alt text from the admin. Pass '' for decorative images.
  @param {string} [loading] - 'lazy' | 'eager' | 'priority' (default 'lazy')
  @param {string} [widths] - Comma-separated srcset widths (default '360, 540, 720, 900, 1080, 1296, 1512, 1728, 2048')
  @param {number} [aspect_ratio] - Crop to a width/height ratio (e.g. 0.75 for 3:4) at the CDN
  @param {string} [crop] - Crop position when aspect_ratio is set (default 'center')
  @param {image} [mobile_image] - Optional art-directed image below the md breakpoint
  @param {number} [mobile_aspect_ratio] - Crop ratio for mobile_image
  @param {string} [mobile_sizes] - `sizes` for mobile_image (default '100vw')
  @param {string} [class] - Class(es) on <picture>
  @param {string} [img_class] - Class(es) on <img>

  @example
  {% render 'picture',
    image: section.settings.image,
    sizes: '100vw',
    loading: 'priority',
    mobile_image: section.settings.image_mobile,
    class: 'hero__media picture--cover'
  %}
{% enddoc %}

{%- if image == blank -%}
  {%- if request.design_mode -%}
    {{- 'image' | placeholder_svg_tag: 'picture__placeholder' -}}
  {%- endif -%}
{%- else -%}
{%- liquid
  assign loading = loading | default: 'lazy'
  assign widths = widths | default: '360, 540, 720, 900, 1080, 1296, 1512, 1728, 2048'
  assign crop = crop | default: 'center'
  assign mobile_sizes = mobile_sizes | default: '100vw'
  assign width_list = widths | split: ','

  if alt == nil
    assign alt = image.alt | default: ''
  endif

  comment
    Largest requested width, capped at the original (the CDN never upscales).
  endcomment
  assign max_width = width_list | last | strip | plus: 0

  comment
    Widest crop the CDN can actually make. It never upscales, and a crop taller than the original
    is silently skipped (it returns the uncropped image). So a landscape photo shown in a portrait
    frame (aspect_ratio < the image's) can be at most image.height × aspect_ratio wide.
  endcomment
  assign crop_limit = image.width
  if aspect_ratio and aspect_ratio < image.aspect_ratio
    assign crop_limit = image.height | times: aspect_ratio | floor
  endif
  if crop_limit < max_width
    assign max_width = crop_limit
  endif

  comment
    Only the widths the CDN can deliver (plus the capped maximum when nothing fits).
  endcomment
  assign usable_widths = ''
  for width_item in width_list
    assign cw = width_item | strip | plus: 0
    if cw <= crop_limit
      assign usable_widths = usable_widths | append: cw | append: ','
    endif
  endfor
  comment
    When the crop limit cuts the list short, offer the limit itself as the largest size.
  endcomment
  assign last_width = width_list | last | strip | plus: 0
  if crop_limit < last_width
    assign limit_key = ',' | append: crop_limit | append: ','
    assign have = ',' | append: usable_widths
    unless have contains limit_key
      assign usable_widths = usable_widths | append: crop_limit | append: ','
    endunless
  endif
  assign widths = usable_widths | remove_last: ','
  assign width_list = widths | split: ','

  assign m_crop_limit = mobile_image.width
  if mobile_image != blank and mobile_aspect_ratio and mobile_aspect_ratio < mobile_image.aspect_ratio
    assign m_crop_limit = mobile_image.height | times: mobile_aspect_ratio | floor
  endif

  if aspect_ratio
    assign max_height = max_width | divided_by: aspect_ratio | round
  endif

  comment
    Editors can set a focal point on images in the admin (Content → Files);
    honour it wherever CSS crops the image (object-fit: cover).
  endcomment
  assign focal_style = nil
  assign focal_point = image.presentation.focal_point | append: ''
  comment
    Every uploaded file reports a centre focal point ("50.0% 50.0%") until an editor sets one.
    Skip that default: as an inline style it would override the section's own position setting.
  endcomment
  if focal_point != blank and focal_point != '50.0% 50.0%'
    assign focal_style = 'object-position: ' | append: focal_point
  endif

  assign img_loading = 'lazy'
  assign fetchpriority = 'auto'
  assign preload = false
  assign decoding = 'async'
  case loading
    when 'eager'
      assign img_loading = 'eager'
    when 'priority'
      assign img_loading = 'eager'
      assign fetchpriority = 'high'
      assign preload = true
      assign decoding = 'sync'
  endcase

  comment
    Priority images are preloaded with our own <link> tags, never image_tag's `preload`:
    Shopify writes that preload into the HTTP Link header with imagesrcset/imagesizes
    unquoted, and their commas split the header, so browsers drop the srcset and fetch
    the wrong file (seen in Lighthouse as a 2-3 s LCP load delay). With an art-directed
    phone image there's one media-scoped preload per viewport.
  endcomment
  assign own_preload = preload
  assign preload = false
-%}
{%- if own_preload -%}
  {%- assign sep = '' -%}
  {%- capture desktop_srcset -%}
    {%- for width_item in width_list -%}
      {%- assign w = width_item | strip | plus: 0 -%}
      {%- if w <= crop_limit -%}
        {{- sep -}}
        {%- if aspect_ratio -%}
          {%- assign h = w | divided_by: aspect_ratio | round -%}
          {{- image | image_url: width: w, height: h, crop: crop }} {{ w }}w
        {%- else -%}
          {{- image | image_url: width: w }} {{ w }}w
        {%- endif -%}
        {%- assign sep = ', ' -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {% # theme-check-disable AssetPreload %}
  {%- if mobile_image != blank -%}
    {%- assign sep = '' -%}
    {%- capture phone_srcset -%}
      {%- for width_item in width_list -%}
        {%- assign w = width_item | strip | plus: 0 -%}
        {%- if w <= m_crop_limit -%}
          {{- sep -}}
          {%- if mobile_aspect_ratio -%}
            {%- assign h = w | divided_by: mobile_aspect_ratio | round -%}
            {{- mobile_image | image_url: width: w, height: h, crop: crop }} {{ w }}w
          {%- else -%}
            {{- mobile_image | image_url: width: w }} {{ w }}w
          {%- endif -%}
          {%- assign sep = ', ' -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    <link rel="preload" as="image" fetchpriority="high" media="(max-width: 47.99rem)" imagesrcset="{{ phone_srcset }}" imagesizes="{{ mobile_sizes }}">
    <link rel="preload" as="image" fetchpriority="high" media="(min-width: 48rem)" imagesrcset="{{ desktop_srcset }}" imagesizes="{{ sizes }}">
  {%- else -%}
    <link rel="preload" as="image" fetchpriority="high" imagesrcset="{{ desktop_srcset }}" imagesizes="{{ sizes }}">
  {%- endif -%}
  {% # theme-check-enable AssetPreload %}
{%- endif -%}

<picture class="picture {{ class }}">
  {%- if mobile_image != blank -%}
    {%- liquid
      assign m_max = width_list | last | strip | plus: 0
      if m_crop_limit < m_max
        assign m_max = m_crop_limit
      endif
      if mobile_aspect_ratio
        assign m_height = m_max | divided_by: mobile_aspect_ratio | round
      else
        assign m_height = m_max | divided_by: mobile_image.aspect_ratio | round
      endif
    -%}
    <source
      media="(max-width: 47.99rem)"
      sizes="{{ mobile_sizes }}"
      width="{{ m_max }}"
      height="{{ m_height }}"
      srcset="
        {%- assign sep = '' -%}
        {%- for width_item in width_list -%}
          {%- assign w = width_item | strip | plus: 0 -%}
          {%- if w <= m_crop_limit -%}
            {{- sep -}}
            {%- if mobile_aspect_ratio -%}
              {%- assign h = w | divided_by: mobile_aspect_ratio | round -%}
              {{- mobile_image | image_url: width: w, height: h, crop: crop }} {{ w }}w
            {%- else -%}
              {{- mobile_image | image_url: width: w }} {{ w }}w
            {%- endif -%}
            {%- assign sep = ', ' -%}
          {%- endif -%}
        {%- endfor -%}
      "
    >
  {%- endif -%}

  {%- if aspect_ratio -%}
    {{-
      image
      | image_url: width: max_width, height: max_height, crop: crop
      | image_tag:
        widths: widths,
        sizes: sizes,
        alt: alt,
        loading: img_loading,
        fetchpriority: fetchpriority,
        decoding: decoding,
        preload: preload,
        class: img_class,
        style: focal_style
    -}}
  {%- else -%}
    {{-
      image
      | image_url: width: max_width
      | image_tag:
        widths: widths,
        sizes: sizes,
        alt: alt,
        loading: img_loading,
        fetchpriority: fetchpriority,
        decoding: decoding,
        preload: preload,
        class: img_class,
        style: focal_style
    -}}
  {%- endif -%}
</picture>
{%- endif -%}
