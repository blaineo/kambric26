{% doc %}
  Prose wrapper for rich text / HTML content: page bodies, article bodies,
  info-page copy, the size guide. Styles headings, paragraphs, blockquotes,
  links, hr, images, lists and tables to match the source's `journal-body`
  typography ([&_h2]/[&_h3]/[&_blockquote]/[&_a]/[&_hr]/[&_img]/[&_ul]/[&_ol]
  rules in ../liquid/css/used-classes.txt). Table styling is new: the source
  has no real `<table>`, but the size guide and other AEO copy need one.

  Use for real Shopify rich text (page.content, article.content, a
  `richtext` setting) — not for laying out custom section markup.

  @param {string} content - HTML/richtext content, e.g. page.content, article.content, block.settings.body
  @param {string} [class] - Extra class(es) on the wrapper

  @example
  {% render 'rte', content: page.content %}
{% enddoc %}
<div class="rte {{ class }}">
  {{ content }}
</div>

{% stylesheet %}
  .rte {
    font-family: var(--font-sans);
    font-size: var(--text-16);
    font-weight: var(--weight-light);
    line-height: var(--leading-relaxed);
    color: var(--color-foreground);
  }

  .rte > :first-child {
    margin-top: 0;
  }

  .rte > :last-child {
    margin-bottom: 0;
  }

  .rte p {
    margin: 0 0 var(--space-6);
  }

  .rte strong,
  .rte b {
    font-weight: var(--weight-medium);
  }

  .rte em,
  .rte i {
    font-style: italic;
  }

  /* [&_h2]: font-serif, 28px, tracking -0.01em, mt-12 mb-4 */
  .rte h2 {
    margin: var(--space-12) 0 var(--space-4);
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: var(--weight-regular);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-editorial);
    color: var(--color-foreground);
  }

  /* [&_h3]: font-serif, 22px, mt-10 mb-3 */
  .rte h3 {
    margin: var(--space-10) 0 var(--space-3);
    font-family: var(--font-serif);
    font-size: var(--text-22);
    font-weight: var(--weight-regular);
    line-height: var(--leading-tight);
    color: var(--color-foreground);
  }

  .rte h4,
  .rte h5,
  .rte h6 {
    margin: var(--space-8) 0 var(--space-3);
    font-family: var(--font-serif);
    font-size: var(--text-18);
    font-weight: var(--weight-regular);
    color: var(--color-foreground);
  }

  /* [&_blockquote]: font-serif italic, 19px, border-l-2 border-primary/40 */
  .rte blockquote {
    margin: var(--space-8) 0;
    padding-left: var(--space-6);
    border-left: 2px solid color-mix(in srgb, var(--color-primary) 40%, transparent);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.1875rem;
    color: var(--color-foreground);
  }

  .rte blockquote > :last-child {
    margin-bottom: 0;
  }

  /* [&_hr]: border-border, my-10 */
  .rte hr {
    margin: var(--space-10) 0;
    border: 0;
    border-top: 1px solid var(--color-border);
  }

  /* [&_img]: my-8, w-full (picture snippet is used for new images; this
     covers images that come from within rich text itself) */
  .rte img {
    display: block;
    width: 100%;
    height: auto;
    margin: var(--space-8) 0;
  }

  /* [&_ul]/[&_ol]: list-disc/decimal, mb-6, pl-6; [&_li]: mb-2 */
  .rte ul,
  .rte ol {
    margin: 0 0 var(--space-6);
    padding-left: var(--space-6);
  }

  .rte ul {
    list-style: disc;
  }

  .rte ol {
    list-style: decimal;
  }

  .rte li {
    margin-bottom: var(--space-2);
  }

  .rte li > ul,
  .rte li > ol {
    margin-top: var(--space-2);
    margin-bottom: 0;
  }

  /* [&_a]: underline, decoration-primary/50, underline-offset-4 */
  .rte a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-primary) 50%, transparent);
    text-underline-offset: 4px;
    transition: text-decoration-color var(--duration-fast) var(--ease-standard);
  }

  .rte a:hover,
  .rte a:focus-visible {
    text-decoration-color: var(--color-primary);
  }

  /* Tables: not in the source (AEO addition for the size guide etc.) */
  .rte table {
    width: 100%;
    margin: var(--space-8) 0;
    border-collapse: collapse;
    font-size: var(--text-14);
  }

  .rte caption {
    margin-bottom: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--text-11);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted-foreground);
    text-align: left;
  }

  .rte th,
  .rte td {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-border);
  }

  .rte th {
    font-family: var(--font-sans);
    font-size: var(--text-11);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label-xs);
    text-transform: uppercase;
    color: var(--color-foreground);
  }

  .rte tbody tr:last-child td {
    border-bottom: 0;
  }

  .rte dl {
    margin: 0 0 var(--space-6);
  }

  .rte dt {
    font-weight: var(--weight-medium);
    color: var(--color-foreground);
  }

  .rte dd {
    margin: 0 0 var(--space-3);
    color: var(--color-muted-foreground);
  }
{% endstylesheet %}
