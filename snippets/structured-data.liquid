{% doc %}
  JSON-LD structured data for search and answer engines (SEO/AEO).
  Built only from Shopify data so it always matches what's on the page.

  - Organization: every page (brand entity: name, logo, social profiles)
  - WebSite + SearchAction: home page (sitelinks search box)
  - Product: product pages (Shopify's structured_data; extended in Phase 2)
  - Article: journal articles (Shopify's structured_data)
  BreadcrumbList, Event and FAQPage arrive with their pages (see docs/MIGRATION_PLAN.md).
{% enddoc %}
{%- liquid
  if settings.logo != blank
    assign org_logo = settings.logo | image_url: width: 600 | prepend: 'https:'
  else
    assign org_logo = 'kambric-wordmark-328w.png' | asset_url | prepend: 'https:'
  endif
  assign same_as = ''
  if settings.social_instagram != blank
    assign same_as = same_as | append: settings.social_instagram | append: '|'
  endif
  if settings.social_pinterest != blank
    assign same_as = same_as | append: settings.social_pinterest | append: '|'
  endif
  assign same_as = same_as | split: '|'
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": {{ request.origin | append: '/#organization' | json }},
    "name": {{ shop.name | json }},
    "url": {{ request.origin | append: routes.root_url | json }},
    "logo": {{ org_logo | json }}
    {%- if shop.description != blank -%}
      , "description": {{ shop.description | json }}
    {%- endif -%}
    {%- if same_as.size > 0 -%}
      , "sameAs": {{ same_as | json }}
    {%- endif %}
  }
</script>

{%- if request.page_type == 'index' %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": {{ request.origin | append: '/#website' | json }},
      "name": {{ shop.name | json }},
      "url": {{ request.origin | append: routes.root_url | json }},
      "publisher": { "@id": {{ request.origin | append: '/#organization' | json }} },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": {{ request.origin | append: routes.search_url | append: '?q={search_term_string}' | json }}
        },
        "query-input": "required name=search_term_string"
      }
    }
  </script>
{%- elsif request.page_type == 'product' %}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
{%- elsif request.page_type == 'article' %}
  <script type="application/ld+json">
    {{ article | structured_data }}
  </script>
{%- endif %}
