{
  "sections": {
    "heading": {
      "type": "catalog-heading",
      "settings": {
        "show_on": "all_only"
      }
    },
    "nav": {
      "type": "category-nav",
      "settings": {
        "show_on": "all_only"
      }
    },
    "hero": {
      "type": "collection-hero",
      "settings": {
        "show_on": "except_all",
        "show_season": false,
        "show_breadcrumbs": false,
        "eyebrow": "Collections"
      }
    },
    "groups": {
      "type": "product-listing",
      "blocks": {
        "psychedelics": {
          "type": "collection_group",
          "settings": {
            "collection": "psychedelics"
          }
        },
        "folklore": {
          "type": "collection_group",
          "settings": {
            "collection": "folklore"
          }
        },
        "whimsy": {
          "type": "collection_group",
          "settings": {
            "collection": "whimsy"
          }
        }
      },
      "block_order": [
        "psychedelics",
        "folklore",
        "whimsy"
      ],
      "settings": {
        "show_on": "all_only",
        "empty_heading": "Nothing in this category yet.",
        "empty_body": ""
      }
    },
    "grid": {
      "type": "product-listing",
      "settings": {
        "show_on": "except_all",
        "match_collection": true,
        "label": "The Pieces",
        "card_layout": "standard",
        "container": "page",
        "empty_heading": "No pieces yet.",
        "empty_body": "<p>New pieces from this collection will be added soon.</p>",
        "pinned_products": [
          "arielle-dress"
        ]
      }
    },
    "cta_shop": {
      "type": "text-cta",
      "settings": {
        "show_on": "all_only",
        "style": "split",
        "message": "Each piece is made in limited quantities — when a print is gone, it doesn't always return.",
        "link_label": "The Archive →",
        "link_url": "/pages/about"
      }
    },
    "cta_detail": {
      "type": "text-cta",
      "settings": {
        "show_on": "except_all",
        "style": "centered",
        "message": "Explore more of the archive.",
        "link_label": "All Collections",
        "link_url": "/collections"
      }
    }
  },
  "order": [
    "heading",
    "nav",
    "hero",
    "groups",
    "grid",
    "cta_shop",
    "cta_detail"
  ]
}
